
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;

//==============================================================================

// Sentinel values for integer representation of snailfish number tokens
//
// Positive values are reserved for "regular" numbers
//
const LB = -1;  // [ left bracket
const RB = -2;  // ] right bracket
const CO = -3;  // , comma

fn unit_test()
{
	// Unit tests
	//println("running unit tests");

	// ******************************
	// Unit test explosions:

	//let s = "[[[[4,3],4],4],[7,[[8,4],9]]]";
	let s = "[[[[[9,8],1],2],3],4]";
	s = "[[6,[5,[4,[3,2]]]],1]";
	let v = str_to_vec(&s);
	let s1 = vec_to_str(&v);
	//println("v = ", v);
	//println("s  = ", s);
	//println("s1 = ", s1);

	s = "[[6,[5,[4,[3,2]]]],1]";
	let exploded = try_explode(&v);
	let expect   = "[[6,[5,[7,0]]],3]";
	//println("e  = ", vec_to_str(&v));
	//println("ex = ", expect);
	//println("exploded = ", exploded);
	//println();
	assert_eq(v, expect);

	s = "[[[[[9,8],1],2],3],4]";
	expect = "[[[[0,9],2],3],4]";
	v = str_to_vec(&s);
	exploded = try_explode(&v);
	//println("e  = ", vec_to_str(&v));
	//println();
	assert_eq(v, expect);

	s = "[7,[6,[5,[4,[3,2]]]]]";
	expect = "[7,[6,[5,[7,0]]]]";
	v = str_to_vec(&s);
	exploded = try_explode(&v);
	//println("e  = ", vec_to_str(&v));
	//println();
	assert_eq(v, expect);

	// the pair [3,2] is unaffected because the pair [7,3] is further to the
	// left; [3,2] would explode on the next action
	s = "[[3,[2,[1,[7,3]]]],[6,[5,[4,[3,2]]]]]";
	expect = "[[3,[2,[8,0]]],[9,[5,[4,[3,2]]]]]";
	v = str_to_vec(&s);
	exploded = try_explode(&v);
	//println("e  = ", vec_to_str(&v));
	//println();
	assert_eq(v, expect);

	s = "[[3,[2,[8,0]]],[9,[5,[4,[3,2]]]]]";
	expect = "[[3,[2,[8,0]]],[9,[5,[7,0]]]]";
	v = str_to_vec(&s);
	exploded = try_explode(&v);
	//println("e  = ", vec_to_str(&v));
	//println();
	assert_eq(v, expect);

	s = "[[[[[4,3],4],4],[7,[[8,4],9]]],[1,1]]";
	let ex1 = "[[[[0,7],4],[7,[[8,4],9]]],[1,1]]";
	let ex2 = "[[[[0,7],4],[15,[0,13]]],[1,1]]";  // after 2nd explosion
	v = str_to_vec(&s);
	exploded = try_explode(&v);
	//println("e  = ", vec_to_str(&v));
	//println();
	assert_eq(v, ex1);
	exploded = try_explode(&v);
	//println("e  = ", vec_to_str(&v));
	//println();
	assert_eq(v, ex2);

	// ******************************
	// Unit test splitting:

	s = "[[[[0,7],4],[15,[0,13]]],[1,1]]";
	expect = "[[[[0,7],4],[[7,8],[0,13]]],[1,1]]";
	v = str_to_vec(&s);
	let split = try_split(&v);
	//println("s  = ", vec_to_str(&v));
	//println("ex = ", expect);
	//println();
	assert_eq(v, expect);

	// Next iteration of previous test
	s = "[[[[0,7],4],[[7,8],[0,13]]],[1,1]]";
	expect = "[[[[0,7],4],[[7,8],[0,[6,7]]]],[1,1]]";
	v = str_to_vec(&s);
	split = try_split(&v);
	//println("s  = ", vec_to_str(&v));
	//println("ex = ", expect);
	//println();
	assert_eq(v, expect);

	// ******************************
	// End-to-end test of iterative explosion plus splitting

	// Individual steps for this example were tested above
	s = "[[[[[4,3],4],4],[7,[[8,4],9]]],[1,1]]";
	expect = "[[[[0,7],4],[[7,8],[6,0]]],[8,1]]";
	v = str_to_vec(&s);
	reduce(&v);
	//println("r  = ", vec_to_str(&v));
	//println("ex = ", expect);
	//println();
	assert_eq(v, expect);

	// ******************************
	// Magnitude tests
	s = "[[9,1],[1,9]]";
	expect = "129";
	let mag = magnitude(str_to_vec(&s));
	//println("magnitude = ", mag);
	assert_eq_str(str(mag), expect);
}

fn magnitude(v: &const [i32; :]): i64
{
	const nv = size(v);
	if nv == 1
	{
		// Base case
		if v[0] < 0
		{
			println(ERROR_STR + "bad token in magnitude()");
			exit(4);
		}
		return i64(v[0]);
	}

	// Get index of middle comma
	let depth = 0;
	let imid = 0;
	for iv in [0: nv]
	{
		if v[iv] == LB
			depth += 1;
		else if v[iv] == RB
			depth -= 1;
		else
		{
			if depth == 1 and v[iv] == CO
			{
				imid = iv;
				break;
			}
		}
	}
	//println("imid = ", imid);
	return
		3 * magnitude(v[1:imid]) +
		2 * magnitude(v[imid+1: nv-1]);
}

fn reduce(v: &[i32; :])
{
	while true
	{
		if try_explode(&v) continue;
		if not try_split(&v) break;
	}
}

fn assert_eq(v: [i32; :], s: str)
{
	if vec_to_str(&v) != s
	{
		println(ERROR_STR + "unit test assert failure!");
		exit(1);
	}
}
fn assert_eq_str(a: str, b: str)
{
	if a != b
	{
		println(ERROR_STR + "unit test assert failure!");
		exit(3);
	}
}

fn try_split(v: &[i32; :]): bool
{
	// Split v in place and return true, or return false if no splitting is
	// needed
	const nv = size(v);
	for iv in [0: nv]
	{
		if v[iv] >= 10
		{
			const vl = v[iv] / 2;
			const vr = v[iv] - vl;
			v = [v[0:iv], [LB, vl, CO, vr, RB], v[iv+1:]];
			return true;
		}
	}
	return false;
}

fn try_explode(v: &[i32; :]): bool
{
	// Explode v in place and return true, or return false if no explosion is
	// needed
	const nv = size(v);

	// Bracket nesting depth
	let depth = 0;
	for iv in [0: nv]
	{
		if v[iv] == LB
			depth += 1;
		else if v[iv] == RB
			depth -= 1;
		else if depth > 4
		{
			//println("explode ", v[iv]);
			const ilb = iv - 1;  // left bracket
			const ilv = iv;      // left value (regular number)
			const irv = iv + 2;  // right value
			const irb = iv + 3;  // right bracket
			//println("v[ilb] = ", v[ilb]);
			//println("v[irb] = ", v[irb]);

			// Find first regular number to the left, or -1 if none
			let ill = ilb;
			while true
			{
				ill -= 1;
				if (ill < 0) break;
				if (v[ill] >= 0) break;
			}
			//println("ill = ", ill);

			// Find first regular number to the right, or nv if none
			let irr = irb;
			while true
			{
				irr += 1;
				if (irr >= nv) break;
				if (v[irr] >= 0) break;
			}
			//println("irr = ", irr);

			// Concatenate result
			const prefix    = v[0: ill];
			const left_pad  = v[ill+1: ilb];
			const left_add  = v[ill] + v[ilv];
			const right_add = v[irr] + v[irv];
			const right_pad = v[irb+1: irr];
			const suffix    = v[irr+1:];
			//println("prefix    = ", vec_to_str(&prefix));
			//println("left_pad  = ", vec_to_str(&left_pad));
			//println("left_add  = ", left_add);
			//println("right_add = ", right_add);
			//println("right_pad = ", vec_to_str(&right_pad));
			//println("suffix    = ", vec_to_str(&suffix));

			if ill < 0 and irr >= nv
			{
				println(ERROR_STR + "empty explosion result?");
				exit(2);
			}
			else if ill < 0
				v = [left_pad, [0], right_pad, [right_add], suffix];
			else if irr >= nv
				v = [prefix, [left_add], left_pad, [0], right_pad];
			else
				v =
					[
						prefix, [left_add], left_pad, [0],
						right_pad, [right_add], suffix
					];

			return true;
		}
	}
	return false;
}

fn vec_to_str(v: &const [i32; :]): str
{
	// Stringify snailfish number
	let s = "";
	for vv in v
		if vv == LB
			s += "[";  // bad regrowth on every element
		else if vv == RB
			s += "]";
		else if vv == CO
			s += ",";
		else
			s += str(vv);
	return s;
}

fn str_to_vec(s: &const str): [i32; :]
{
	// Parse a snailfish number from a string to its tokenized int vector
	// representation
	const ns = len(s);
	let v = [-1; ns];
	let nv = 0;
	let i = 0;
	while i < ns
	{
		if s[i] == "["
			v[nv] = LB;
		else if s[i] == "]"
			v[nv] = RB;
		else if s[i] == ","
			v[nv] = CO;
		else
		{
			// Handle values >= 10, although we shouldn't need to after
			// reduction
			const i0 = i;
			while is_digit(s[i])
				i += 1;
			v[nv] = parse_i32(s[i0:i]);
			i -= 1;
		}
		nv += 1;
		i += 1;
	}
	return v[:nv];
}

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	unit_test();

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	let s1 = "";
	let first = true;
	while not eof(f)
	{
		//println("str_ = ", str_);
		if first
		{
			first = false;
			s1 = str_;
		}
		else
		{
			let v1 = str_to_vec(s1);
			let v2 = str_to_vec(str_);
			let vs = [[LB], v1, [CO], v2, [RB]];
			//println("v1   = ", vec_to_str(&v1));
			//println("v2   = ", vec_to_str(&v2));
			//println("vs   = ", vec_to_str(&vs));
			reduce(&vs);
			s1 = vec_to_str(vs);
			//println("s1 = ", s1);
			//exit(0);
		}

		str_ = readln(f);
	}
	close(f);

	sum_ = magnitude(str_to_vec(s1));

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;
	const lines = readlns_(args.input_filename);
	const nl = size(lines);
	for i1 in [0: nl]
	for i2 in [0: i1]
	{
		// Could avoid the O(n^2) str_to_vec() calls by saving vecs ahead of
		// time, but need a struct helper for vec of vecs
		const v1 = str_to_vec(lines[i1]);
		const v2 = str_to_vec(lines[i2]);

		let vs = [[LB], v1, [CO], v2, [RB]];
		reduce(&vs);
		sum_ = max(sum_, magnitude(&vs));

		vs = [[LB], v2, [CO], v1, [RB]];
		reduce(&vs);
		sum_ = max(sum_, magnitude(&vs));
	}
	println("part 2 = ", sum_);
	return str(sum_);
}

