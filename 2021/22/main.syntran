//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const XMIN = -50;
	const YMIN = -50;
	const ZMIN = -50;
	const XMAX =  50+1;
	const YMAX =  50+1;
	const ZMAX =  50+1;

	const NX = XMAX - XMIN;
	const NY = YMAX - YMIN;
	const NZ = ZMAX - ZMIN;
	let g = [false; NX, NY, NZ];

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	while not eof(f)
	{
		//println("str_ = ", str_);

		let nums = parse_i32_delim(str_, "onff xyz=.,");
		//println("nums = ", nums);
		const xmin = nums[0];
		const xmax = nums[1]+1;
		const ymin = nums[2];
		const ymax = nums[3]+1;
		const zmin = nums[4];
		const zmax = nums[5]+1;

		const is_on = starts_with_(str_, "on");

		//println();
		str_ = readln(f);

		if (xmax < XMIN) continue;
		if (ymax < YMIN) continue;
		if (zmax < ZMIN) continue;
		if (xmin >= XMAX) continue;
		if (ymin >= YMAX) continue;
		if (zmin >= ZMAX) continue;

		g[
			xmin-XMIN: xmax-XMIN,
			ymin-YMIN: ymax-YMIN,
			zmin-ZMIN: zmax-ZMIN,
		] = is_on;
	}
	close(f);
	sum_ = count(g);

	println("part 1 = ", sum_);
	return str(sum_);
}

struct Cube
{
	// Misnomer. Not necessarily a cube, just an axis-aligned rectangular prism
	lo: [i32; :],
	hi: [i32; :],
}
fn cube(xlo: i32, xhi: i32, ylo: i32, yhi: i32, zlo: i32, zhi: i32): Cube
{
	// Constructor for scalar arg compatibility
	return Cube
	{
		lo = [xlo, ylo, zlo],
		hi = [xhi, yhi, zhi],
	};
}
struct Cubes
{
	n: i32,
	cap: i32,
	live: [bool; :],
	lo: [i32; :,:],
	hi: [i32; :,:],

	// With properly amortized vector growth and avoiding recursion (for
	// multiple passes of adding/cutting), real input runs in under 2 s. I was
	// prepared to add spatial bucketing but it doesn't seem necessary
	fn set(i: i32, a: &const Cube)
	{
		live[i] = true;
		lo[:,i] = a.lo;
		hi[:,i] = a.hi;
	}
	fn push(a: &const Cube)
	{
		if n >= cap
		{
			const nd = size(a.lo);
			let new_cap = 1;
			if cap > 0
				new_cap = cap * 2;
			let itmp = [0; nd, new_cap];
			itmp[:,0:n] = lo;
			lo = itmp;
			itmp[:,0:n] = hi;
			hi = itmp;

			let btmp = [false; new_cap];
			btmp[0:n] = live;
			live = btmp;

			cap = new_cap;
		}
		lo[:,n] = a.lo;
		hi[:,n] = a.hi;
		live[n] = true; // pushed cubes are always live/active

		n += 1;
	}
}
fn new_cubes(): Cubes
{
	const n = 0;
	const cap = 0;
	return Cubes
	{
		n = n,
		cap = cap,
		live = [true; cap],
		lo = [0; 0, cap],
		hi = [0; 0, cap],
	};
}

fn cut_cube(c: &Cubes, d: Cube)
{
	//println();
	//println("cutting d = ", d);
	if any(d.lo >= d.hi)
	{
		// Trivial case: empty cut
		return;
	}
	if c.n == 0
	{
		// Trivial case: nothing to cut
		return;
	}
	let i = -1;
	while true
	{
		// Careful! This loop appends and grows c.n, so it can't be a for loop
		// which stops at initial `c.n` before growth!
		i += 1;
		if (i > c.n) break;
		if (not c.live[i]) continue;

		// Are dimensions disjoint?
		const nd = size(d.lo);
		const dis = d.lo >= c.hi[:,i] or c.lo[:,i] >= d.hi;
		const disjoint = any(dis);

		// Are cut dimensions completely inside
		const ins = c.lo[:,i] <= d.lo and d.hi <= c.hi[:,i];

		// Do cut dimensions completely envelope an initial cube?
		const env = d.lo <= c.lo[:,i] and c.hi[:,i] <= d.hi;

		// Straddling low end?
		const stl = d.lo < c.lo[:,i] and c.lo[:,i] <= d.hi and d.hi < c.hi[:,i];

		// Straddling high end?
		const sth = c.lo[:,i] < d.lo and d.lo <= c.hi[:,i] and c.hi[:,i] < d.hi;

		//println("nd = ", nd);
		//println("disjoint = ", disjoint);
		//println("d x in ", [d.lo, d.hi]);
		//println("c x in ", [c.lo[:,i], c.hi[:,i]]);
		//println("dis xyz = ", dis);
		//println("ins xyz = ", ins);
		//println("env xyz = ", env);
		//println("stl xyz = ", stl);
		//println("sth xyz = ", sth);

		if disjoint
		{
			// no-op
			continue;
		}
		else if all(env)
		{
			// Complete cut of this cube
			//println("completely enveloping");
			c.live[i] = false;
			continue;
		}

		let handled = false;
		for id in [0: nd]
		if stl[id] or sth[id]
		{
			if (handled) continue;
			handled = true;
			// Split initial cube in x direction. Replace initial cube with two
			// new cubes and then continue cutting remaining cubes
			//println("straddling id = ", id);
			let split = d.lo[id];
			if (stl[id]) split = d.hi[id];
			let d1 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			let d2 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			d1.hi[id] = split;
			d2.lo[id] = split;
			c.set(i, d1);
			i -= 1;  // process cut of d1 on next pass
			c.push(d2);
		}
		if (handled) continue;

		// If you try to handle cases like (envx and not insx), recursion is
		// required because we have to split the added cube and then recurse for
		// its three new sub-cubes
		//
		// By handling (insx and not envx) instead, we can split the initial
		// cube instead and just continue on another loop iteration instead of
		// recursing, which would waste a lot of processing on already-processed
		// cubes earlier in the list
		for id in [0: nd]
		if ins[id] and not env[id]
		{
			if (handled) continue;
			handled = true;
			// Split into 3 in x
			//println("inside id = ", id);
			let spl1 = d.lo[id];
			let spl2 = d.hi[id];
			let d1 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			let d2 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			let d3 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			d1.hi[id] = spl1;
			d2.lo[id] = spl1;
			d2.hi[id] = spl2;
			d3.lo[id] = spl2;
			c.set(i, d1);
			i -= 1;
			c.push(d2);
			c.push(d3);
		}
		if (handled) continue;
	}
	return;
}

fn add_cube(c: &Cubes, a: Cube)
{
	//println();
	//println("adding a = ", a);
	if any(a.lo >= a.hi)
	{
		// Trivial case: empty addition
		return;
	}
	if c.n == 0
	{
		// Trivial case: first cube
		c.push(a);
		return;
	}
	let all_disjoint = true;
	let all_disjoint0 = all_disjoint;
	let i = -1;
	while true
	{
		i += 1;
		if (i > c.n) break;
		if (not c.live[i]) continue;

		// Are dimensions disjoint?
		const nd = size(a.lo);
		const dis = a.lo >= c.hi[:,i] or c.lo[:,i] >= a.hi;
		const disjoint = any(dis);
		all_disjoint = all_disjoint and disjoint;

		// Are added dimensions completely inside
		const ins = c.lo[:,i] <= a.lo and a.hi <= c.hi[:,i];

		// Do added dimensions completely envelope an initial cube?
		const env = a.lo <= c.lo[:,i] and c.hi[:,i] <= a.hi;

		// Straddling low end?
		const stl = a.lo < c.lo[:,i] and c.lo[:,i] <= a.hi and a.hi < c.hi[:,i];

		// Straddling high end?
		const sth = c.lo[:,i] < a.lo and a.lo <= c.hi[:,i] and c.hi[:,i] < a.hi;

		//println("disjoint = ", disjoint);
		//println("a x in ", [a.xlo, a.xhi]);
		//println("c x in ", [c.xlo[i], c.xhi[i]]);
		//println("dis xyz = ", [disx, disy, disz]);
		//println("ins xyz = ", [insx, insy, insz]);
		//println("env xyz = ", [envx, envy, envz]);
		//println("stl xyz = ", [stlx, stly, stlz]);
		//println("sth xyz = ", [sthx, sthy, sthz]);

		if disjoint
		{
			// no-op. all_disjoint case appended below
			continue;
		}
		else if all(ins)
		{
			// no-op. retain initial cube which `a` is inside of
			//println("completely inside");
			return;
		}
		else if all(env)
		{
			// Added cube completely envelopes initial cube. Replace initial
			// with added
			//println("completely enveloping");
			c.live[i] = false;
			all_disjoint = all_disjoint0;
			continue;
		}

		let handled = false;
		for id in [0: nd]
		if stl[id] or sth[id]
		{
			if (handled) continue;
			handled = true;
			// Split in x direction
			//println("straddling +-x");

			// Instead of killing c.[i], we can slot c1 into its place,
			// then decrement i before continuing loop
			let split = a.hi[id];
			if (sth[id]) split = a.lo[id];
			let c1 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			let c2 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			c1.hi[id] = split;
			c2.lo[id] = split;
			c.set(i, c1);
			i -= 1;
			c.push(c2);
		}
		if (handled) continue;

		for id in [0: nd]
		if ins[id] and not env[id]
		{
			if (handled) continue;
			handled = true;
			// There should be a way to consolidate this with the straddling
			// case by min/max'ing to push an empty cube
			let spl1 = a.lo[id];
			let spl2 = a.hi[id];
			let c1 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			let c2 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			let c3 = Cube{ lo=c.lo[:,i], hi=c.hi[:,i] };
			c1.hi[id] = spl1;
			c2.lo[id] = spl1;
			c2.hi[id] = spl2;
			c3.lo[id] = spl2;
			c.set(i, c1);
			i -= 1;
			c.push(c2);
			c.push(c3);
		}
		if (handled) continue;

		//else
		//{
		//	println(ERROR_STR + "unhandled case in add_cube()");
		//	exit(1);
		//}
	}
	if all_disjoint
	{
		// Simply append the added cube to the list
		c.push(a);
	}
	return;
}

fn test_cut(c: Cubes, d: Cube)
{
	// Remove cube `d` from cubes `c` and verify the volume against the
	// brute-force method from part 1

	//println();
	//println("------------------------------------------");
	//println("Testing deletion of d = ", d);
	const xlo = min(minval(c.lo[0,:]), d.lo[0]);
	const ylo = min(minval(c.lo[1,:]), d.lo[1]);
	const zlo = min(minval(c.lo[2,:]), d.lo[2]);
	const xhi = max(maxval(c.hi[0,:]), d.hi[0]);
	const yhi = max(maxval(c.hi[1,:]), d.hi[1]);
	const zhi = max(maxval(c.hi[2,:]), d.hi[2]);
	const nx = xhi - xlo;
	const ny = yhi - ylo;
	const nz = zhi - zlo;
	let g = [false; nx, ny, nz];
	for i in [0: c.n]
		g[
			c.lo[0,i] - xlo: c.hi[0,i] - xlo,
			c.lo[1,i] - ylo: c.hi[1,i] - ylo,
			c.lo[2,i] - zlo: c.hi[2,i] - zlo,
		] = true;
	//println("count(g) = ", count(g));
	g[
		d.lo[0] - xlo: d.hi[0] - xlo,
		d.lo[1] - ylo: d.hi[1] - ylo,
		d.lo[2] - zlo: d.hi[2] - zlo,
	] = false;
	//println("count(g) = ", count(g));
	const vol_expect = count(g);

	cut_cube(&c, d);
	//println("c = ", c);

	// Get vol from bounds only (without `g`) and compare to expected vol
	let vol = 0;
	for i in [0: c.n]
	{
		if (not c.live[i]) continue;
		const inc = product(c.hi[:,i] - c.lo[:,i]);
		//println("inc = ", inc);
		vol += inc;
	}
	//println("vol = ", vol);
	if vol != vol_expect
	{
		println(ERROR_STR + "bad volume for cube deletion");
		exit(3);
	}
}

fn test_add(c: Cubes, a: Cube)
{
	// Merge added cube `a` into cubes `c` and verify the volume against the
	// brute-force method from part 1

	//println("Testing addition of a = ", a);
	const xlo = min(minval(c.lo[0,:]), a.lo[0]);
	const ylo = min(minval(c.lo[1,:]), a.lo[1]);
	const zlo = min(minval(c.lo[2,:]), a.lo[2]);
	const xhi = max(maxval(c.hi[0,:]), a.hi[0]);
	const yhi = max(maxval(c.hi[1,:]), a.hi[1]);
	const zhi = max(maxval(c.hi[2,:]), a.hi[2]);
	const nx = xhi - xlo;
	const ny = yhi - ylo;
	const nz = zhi - zlo;
	let g = [false; nx, ny, nz];
	for i in [0: c.n]
		g[
			c.lo[0,i] - xlo: c.hi[0,i] - xlo,
			c.lo[1,i] - ylo: c.hi[1,i] - ylo,
			c.lo[2,i] - zlo: c.hi[2,i] - zlo,
		] = true;
	//println("count(g) = ", count(g));
	g[
		a.lo[0] - xlo: a.hi[0] - xlo,
		a.lo[1] - ylo: a.hi[1] - ylo,
		a.lo[2] - zlo: a.hi[2] - zlo,
	] = true;
	//println("count(g) = ", count(g));
	const vol_expect = count(g);

	add_cube(&c, a);
	//println("c = ", c);

	// Get vol from bounds only (without `g`) and compare to expected vol
	let vol = 0;
	for i in [0: c.n]
	{
		if (not c.live[i]) continue;
		const inc = product(c.hi[:,i] - c.lo[:,i]);
			//(c.hi[0,i] - c.lo[0,i]) *
			//(c.hi[1,i] - c.lo[1,i]) *
			//(c.hi[2,i] - c.lo[2,i]);
		//println("inc = ", inc);
		vol += inc;
	}
	//println("vol = ", vol);
	if vol != vol_expect
	{
		println(ERROR_STR + "bad volume for cube addition");
		exit(2);
	}
}

fn unit_tests()
{
	let init_cube = cube(
		-10, 10,
		-10, 10,
		-10, 10,
	);
	let init_cubes = new_cubes();
	//println("init_cubes = ", init_cubes);
	//add_cube(&init_cubes, init_cube);
	init_cubes.push(init_cube);
	//println("init_cubes = ", init_cubes);

	// ****************
	// Subtraction tests

	// Enveloping by a lot
	test_cut(init_cubes,
		cube(-11, 11, -11, 11, -11, 11));

	// Enveloping just barely
	test_cut(init_cubes,
		cube(-10, 10, -10, 10, -10, 10));

	// Cut whole +x side
	test_cut(init_cubes,
		cube(5, 15, -11, 11, -11, 11));
	test_cut(init_cubes,
		cube(5, 10, -11, 11, -11, 11));

	// Cut whole -x side
	test_cut(init_cubes,
		cube(-15, 5, -11, 11, -11, 11));
	test_cut(init_cubes,
		cube(-10, 0, -11, 11, -11, 11));

	// Cut whole +-y side
	test_cut(init_cubes,
		cube(-15, 15, -11, 0, -11, 11));

	// Cut +xyz corner
	test_cut(init_cubes,
		cube(6, 11, 7, 13, 8, 15));

	// Cut -xyz corner
	test_cut(init_cubes,
		cube(-16, 1, -17, 3, -18, 5));

	// Could use more cut unit tests, but i was close enough for an end-to-end
	// test with the sample inputs at this point

	// ****************
	// Addition tests

	// Disjoint, just barely
	test_add(init_cubes,
		cube(10, 14, 10, 15, 10, 16));

	// Disjoint, larger gap
	test_add(init_cubes,
		cube(11, 14, 12, 15, 13, 16));

	// Disjoint, x only
	test_add(init_cubes,
		cube(10, 14, 5, 15, 5, 16));

	// Disjoint, y only
	test_add(init_cubes,
		cube(5, 14, 10, 15, 5, 16));

	// Disjoint, z only
	test_add(init_cubes,
		cube(5, 14, 5, 15, 10, 16));

	// Added cube inside of initial cube
	test_add(init_cubes,
		cube(3, 4, -5, 6, -8, 4));

	// Added cube completely envelopes initial cube
	test_add(init_cubes,
		cube(12, 13, -14, 15, -16, 17));

	// Attached inside of -x face
	test_add(init_cubes,
		cube(12, 5, -4, 5, -6, 7));

	// Attached inside of -y face
	test_add(init_cubes,
		cube(2, 5, -14, 5, -6, 7));

	// Attached inside of -z face
	test_add(init_cubes,
		cube(2, 5, -4, 5, -16, 7));

	// Attached inside of +x face
	test_add(init_cubes,
		cube(2, 15, -4, 5, -6, 7));

	// Attached inside of +y face
	test_add(init_cubes,
		cube(2, 5, -4, 15, -6, 7));

	// Attached inside of +z face
	test_add(init_cubes,
		cube(2, 5, -4, 5, -6, 17));

	// Attached outside of -x face
	test_add(init_cubes,
		cube(12, 5, -14, 15, -16, 17));

	// Attached outside of -y face
	test_add(init_cubes,
		cube(12, 15, -14, 5, -16, 17));

	// Attached outside of -z face
	test_add(init_cubes,
		cube(12, 15, -14, 15, -16, 7));

	// Attached outside of +xyz faces respectively
	test_add(init_cubes,
		cube(2, 15, -14, 15, -16, 17));
	test_add(init_cubes,
		cube(12, 15, 4, 15, -16, 17));
	test_add(init_cubes,
		cube(12, 15, -14, 15, 6, 17));

	// Interlocked cases, e.g. `stlx and insy and envz`
	//println("interlock 1");
	test_add(init_cubes,  // stlx and insy and envz
		cube(12, 5, -4, 5, -16, 17));
	test_add(init_cubes,  // insx and envy and sthz
		cube(2, 5, -14, 15, -6, 17));
	test_add(init_cubes,  // envx and sthy and insz
		cube(12, 15, -4, 15, -6, 7));

	// Inside of +x+y edge
	test_add(init_cubes,
		cube(5, 15, 4, 14, -6, 7));

	// Inside of -x+y edge
	test_add(init_cubes,
		cube(15, 5, 4, 14, -6, 7));

	// Inside of +x-y edge
	test_add(init_cubes,
		cube(5, 15, -14, 4, -6, 7));

	// Inside of -x-y edge
	test_add(init_cubes,
		cube(15, 5, -14, 4, -6, 7));

	test_add(init_cubes,  // envx and insy and insz
		cube(15, 15, -4, 4, -6, 7));
	test_add(init_cubes,  // envx and envy and insz
		cube(15, 15, -14, 14, -6, 7));

	//println("Unit tests passed!");
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;
	unit_tests();

	let c = new_cubes();
	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	let kk = 0;
	while not eof(f)
	{
		//println("str_ = ", str_);

		let nums = parse_i32_delim(str_, "onff xyz=.,");
		//println("nums = ", nums);
		const xmin = nums[0];
		const xmax = nums[1]+1;
		const ymin = nums[2];
		const ymax = nums[3]+1;
		const zmin = nums[4];
		const zmax = nums[5]+1;

		const is_on = starts_with_(str_, "on");

		str_ = readln(f);
		//println("kk = ", kk);
		kk += 1;

		let a = cube(
			xmin, xmax,
			ymin, ymax,
			zmin, zmax,
		);
		if is_on
			add_cube(&c, a);
		else
			cut_cube(&c, a);
	}
	close(f);
	println("number of divided cubes = ", c.n);
	println("number of live cubes    = ", count(c.live[0:c.n]));
	for i in [0: c.n]
	{
		if (not c.live[i]) continue;
		sum_ += product(i64(c.hi[:,i] - c.lo[:,i]));
	}

	println("part 2 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2021/22" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "543306";
	let expect2 = "1285501151402480";
	let expect1_test = "474140";  // actually part 2's test input
	let expect2_test = "2758514936282235";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

//==============================================================================

