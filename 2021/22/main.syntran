
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const XMIN = -50;
	const YMIN = -50;
	const ZMIN = -50;
	const XMAX =  50+1;
	const YMAX =  50+1;
	const ZMAX =  50+1;

	const NX = XMAX - XMIN;
	const NY = YMAX - YMIN;
	const NZ = ZMAX - ZMIN;
	let g = [false; NX, NY, NZ];

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	while not eof(f)
	{
		//println("str_ = ", str_);

		let nums = parse_i32_delim(str_, "onff xyz=.,");
		//println("nums = ", nums);
		const xmin = nums[0];
		const xmax = nums[1]+1;
		const ymin = nums[2];
		const ymax = nums[3]+1;
		const zmin = nums[4];
		const zmax = nums[5]+1;

		const is_on = starts_with_(str_, "on");

		//println();
		str_ = readln(f);

		if (xmax < XMIN) continue;
		if (ymax < YMIN) continue;
		if (zmax < ZMIN) continue;
		if (xmin >= XMAX) continue;
		if (ymin >= YMAX) continue;
		if (zmin >= ZMAX) continue;

		g[
			xmin-XMIN: xmax-XMIN,
			ymin-YMIN: ymax-YMIN,
			zmin-ZMIN: zmax-ZMIN,
		] = is_on;
	}
	close(f);
	sum_ = count(g);

	println("part 1 = ", sum_);
	return str(sum_);
}

struct Cube
{
	// Misnomer. Not necessarily a cube, just an axis-aligned rectangular prism
	xlo: i32,
	ylo: i32,
	zlo: i32,
	xhi: i32,
	yhi: i32,
	zhi: i32,
}
struct Cubes
{
	n: i32,
	cap: i32,
	live: [bool; :],
	xlo: [i32; :],
	ylo: [i32; :],
	zlo: [i32; :],
	xhi: [i32; :],
	yhi: [i32; :],
	zhi: [i32; :],

	// With properly amortized vector growth and avoiding recursion (for
	// multiple passes of adding/cutting), real input runs in under 2 s. I was
	// prepared to add spatial bucketing but it doesn't seem necessary
	fn set(i: i32, a: &const Cube)
	{
		live[i] = true;
		xlo[i] = a.xlo;
		ylo[i] = a.ylo;
		zlo[i] = a.zlo;
		xhi[i] = a.xhi;
		yhi[i] = a.yhi;
		zhi[i] = a.zhi;
	}
	fn push(a: &const Cube)
	{
		if n >= cap
		{
			let new_cap = 1;
			if cap > 0
				new_cap = cap * 2;
			let itmp = [0; new_cap];
			itmp[0:n] = xlo;
			xlo = itmp;
			itmp[0:n] = ylo;
			ylo = itmp;
			itmp[0:n] = zlo;
			zlo = itmp;
			itmp[0:n] = xhi;
			xhi = itmp;
			itmp[0:n] = yhi;
			yhi = itmp;
			itmp[0:n] = zhi;
			zhi = itmp;

			let btmp = [false; new_cap];
			btmp[0:n] = live;
			live = btmp;

			cap = new_cap;
		}
		xlo [n] = a.xlo;
		ylo [n] = a.ylo;
		zlo [n] = a.zlo;
		xhi [n] = a.xhi;
		yhi [n] = a.yhi;
		zhi [n] = a.zhi;
		live[n] = true; // pushed cubes are always live/active

		n += 1;
	}
}
fn new_cubes(): Cubes
{
	const n = 0;
	const cap = 0;
	return Cubes
	{
		n = n,
		cap = cap,
		live = [true; cap],
		xlo = [0; cap],
		ylo = [0; cap],
		zlo = [0; cap],
		xhi = [0; cap],
		yhi = [0; cap],
		zhi = [0; cap],
	};
}

fn cut_cube(c: &Cubes, d: Cube)
{
	//println();
	//println("cutting d = ", d);
	if
		d.xlo >= d.xhi or
		d.ylo >= d.yhi or
		d.zlo >= d.zhi
	{
		// Trivial case: empty cut
		return;
	}
	if c.n == 0
	{
		// Trivial case: nothing to cut
		return;
	}
	let i = -1;
	while true
	{
		// Careful! This loop appends and grows c.n, so it can't be a for loop
		// which stops at initial `c.n` before growth!
		i += 1;
		if (i > c.n) break;
		if (not c.live[i]) continue;

		// Are dimensions disjoint?
		const disx = d.xlo >= c.xhi[i] or c.xlo[i] >= d.xhi;
		const disy = d.ylo >= c.yhi[i] or c.ylo[i] >= d.yhi;
		const disz = d.zlo >= c.zhi[i] or c.zlo[i] >= d.zhi;
		const disjoint = disx or disy or disz;

		// Are cut dimensions completely inside
		const insx = c.xlo[i] <= d.xlo and d.xhi <= c.xhi[i];
		const insy = c.ylo[i] <= d.ylo and d.yhi <= c.yhi[i];
		const insz = c.zlo[i] <= d.zlo and d.zhi <= c.zhi[i];

		// Do cut dimensions completely envelope an initial cube?
		const envx = d.xlo <= c.xlo[i] and c.xhi[i] <= d.xhi;
		const envy = d.ylo <= c.ylo[i] and c.yhi[i] <= d.yhi;
		const envz = d.zlo <= c.zlo[i] and c.zhi[i] <= d.zhi;

		// Straddling low end?
		const stlx = d.xlo < c.xlo[i] and c.xlo[i] <= d.xhi and d.xhi < c.xhi[i];
		const stly = d.ylo < c.ylo[i] and c.ylo[i] <= d.yhi and d.yhi < c.yhi[i];
		const stlz = d.zlo < c.zlo[i] and c.zlo[i] <= d.zhi and d.zhi < c.zhi[i];

		// Straddling high end?
		const sthx = c.xlo[i] < d.xlo and d.xlo <= c.xhi[i] and c.xhi[i] < d.xhi;
		const sthy = c.ylo[i] < d.ylo and d.ylo <= c.yhi[i] and c.yhi[i] < d.yhi;
		const sthz = c.zlo[i] < d.zlo and d.zlo <= c.zhi[i] and c.zhi[i] < d.zhi;

		//println("disjoint = ", disjoint);
		//println("d x in ", [d.xlo, d.xhi]);
		//println("c x in ", [c.xlo[i], c.xhi[i]]);
		//println("dis xyz = ", [disx, disy, disz]);
		//println("ins xyz = ", [insx, insy, insz]);
		//println("env xyz = ", [envx, envy, envz]);
		//println("stl xyz = ", [stlx, stly, stlz]);
		//println("sth xyz = ", [sthx, sthy, sthz]);

		if disjoint
		{
			// no-op
		}
		else if envx and envy and envz
		{
			// Complete cut of this cube
			//println("completely enveloping");
			c.live[i] = false;
		}

		else if stlx or sthx
		{
			// Split initial cube in x direction. Replace initial cube with two
			// new cubes and then continue cutting remaining cubes
			//println("straddling +-x");
			let split = d.xlo;
			if (stlx) split = d.xhi;
			const d1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i],
			                 xhi=split   , yhi=c.yhi[i], zhi=c.zhi[i] };
			const d2 = Cube{ xlo=split   , ylo=c.ylo[i], zlo=c.zlo[i],
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i] };
			c.set(i, d1);
			i -= 1;  // process cut of d1 on next pass
			c.push(d2);
		}
		else if stly or sthy
		{
			// Split in y
			//println("straddling +-y");
			let split = d.ylo;
			if (stly) split = d.yhi;
			const d1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i],
			                 xhi=c.xhi[i], yhi=split   , zhi=c.zhi[i] };
			const d2 = Cube{ xlo=c.xlo[i], ylo=split   , zlo=c.zlo[i],
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i] };
			c.set(i, d1);
			i -= 1;
			c.push(d2);
		}
		else if stlz or sthz
		{
			// Split in z
			//println("straddling +-z");
			let split = d.zlo;
			if (stlz) split = d.zhi;
			const d1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=split   , };
			const d2 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=split   , 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, d1);
			i -= 1;
			c.push(d2);
		}

		// If you try to handle cases like (envx and not insx), recursion is
		// required because we have to split the added cube and then recurse for
		// its three new sub-cubes
		//
		// By handling (insx and not envx) instead, we can split the initial
		// cube instead and just continue on another loop iteration instead of
		// recursing, which would waste a lot of processing on already-processed
		// cubes earlier in the list
		else if insx and not envx
		{
			// Split into 3 in x
			//println("inside x");
			let spl1 = d.xlo;
			let spl2 = d.xhi;
			const d1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i],
			                 xhi=spl1    , yhi=c.yhi[i], zhi=c.zhi[i], };
			const d2 = Cube{ xlo=spl1    , ylo=c.ylo[i], zlo=c.zlo[i],
			                 xhi=spl2    , yhi=c.yhi[i], zhi=c.zhi[i], };
			const d3 = Cube{ xlo=spl2    , ylo=c.ylo[i], zlo=c.zlo[i],
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, d1);
			i -= 1;
			c.push(d2);
			c.push(d3);
		}
		else if insy and not envy
		{
			// Split into 3 in y
			//println("inside y");
			let spl1 = d.ylo;
			let spl2 = d.yhi;
			const d1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i],
			                 xhi=c.xhi[i], yhi=spl1    , zhi=c.zhi[i], };
			const d2 = Cube{ xlo=c.xlo[i], ylo=spl1    , zlo=c.zlo[i],
			                 xhi=c.xhi[i], yhi=spl2    , zhi=c.zhi[i], };
			const d3 = Cube{ xlo=c.xlo[i], ylo=spl2    , zlo=c.zlo[i],
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, d1);
			i -= 1;
			c.push(d2);
			c.push(d3);
		}
		else if insz and not envz
		{
			// Split into 3 in z
			//println("inside z");
			let spl1 = d.zlo;
			let spl2 = d.zhi;
			const d1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=spl1    , };
			const d2 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=spl1    , 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=spl2    , };
			const d3 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=spl2    , 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, d1);
			i -= 1;
			c.push(d2);
			c.push(d3);
		}

		else
		{
			println(ERROR_STR + "unhandled case in cut_cube()");
			exit(1);
		}
	}
	return;
}

fn add_cube(c: &Cubes, a: Cube)
{
	//println();
	//println("adding a = ", a);
	if
		a.xlo >= a.xhi or
		a.ylo >= a.yhi or
		a.zlo >= a.zhi
	{
		// Trivial case: empty addition
		return;
	}
	if c.n == 0
	{
		// Trivial case: first cube
		c.push(a);
		return;
	}
	let all_disjoint = true;
	let all_disjoint0 = all_disjoint;
	let i = -1;
	while true
	{
		i += 1;
		if (i > c.n) break;
		if (not c.live[i]) continue;

		// Are dimensions disjoint?
		const disx = a.xlo >= c.xhi[i] or c.xlo[i] >= a.xhi;
		const disy = a.ylo >= c.yhi[i] or c.ylo[i] >= a.yhi;
		const disz = a.zlo >= c.zhi[i] or c.zlo[i] >= a.zhi;
		const disjoint = disx or disy or disz;
		all_disjoint = all_disjoint and disjoint;

		// Are added dimensions completely inside
		const insx = c.xlo[i] <= a.xlo and a.xhi <= c.xhi[i];
		const insy = c.ylo[i] <= a.ylo and a.yhi <= c.yhi[i];
		const insz = c.zlo[i] <= a.zlo and a.zhi <= c.zhi[i];

		// Do added dimensions completely envelope an initial cube?
		const envx = a.xlo <= c.xlo[i] and c.xhi[i] <= a.xhi;
		const envy = a.ylo <= c.ylo[i] and c.yhi[i] <= a.yhi;
		const envz = a.zlo <= c.zlo[i] and c.zhi[i] <= a.zhi;

		// Straddling low end?
		const stlx = a.xlo < c.xlo[i] and c.xlo[i] <= a.xhi and a.xhi < c.xhi[i];
		const stly = a.ylo < c.ylo[i] and c.ylo[i] <= a.yhi and a.yhi < c.yhi[i];
		const stlz = a.zlo < c.zlo[i] and c.zlo[i] <= a.zhi and a.zhi < c.zhi[i];

		// Straddling high end?
		const sthx = c.xlo[i] < a.xlo and a.xlo <= c.xhi[i] and c.xhi[i] < a.xhi;
		const sthy = c.ylo[i] < a.ylo and a.ylo <= c.yhi[i] and c.yhi[i] < a.yhi;
		const sthz = c.zlo[i] < a.zlo and a.zlo <= c.zhi[i] and c.zhi[i] < a.zhi;

		//println("disjoint = ", disjoint);
		//println("a x in ", [a.xlo, a.xhi]);
		//println("c x in ", [c.xlo[i], c.xhi[i]]);
		//println("dis xyz = ", [disx, disy, disz]);
		//println("ins xyz = ", [insx, insy, insz]);
		//println("env xyz = ", [envx, envy, envz]);
		//println("stl xyz = ", [stlx, stly, stlz]);
		//println("sth xyz = ", [sthx, sthy, sthz]);

		if disjoint
		{
			// no-op. all_disjoint case appended below
		}
		else if insx and insy and insz
		{
			// no-op. retain initial cube which `a` is inside of
			//println("completely inside");
			return;
		}
		else if envx and envy and envz
		{
			// Added cube completely envelopes initial cube. Replace initial
			// with added
			//println("completely enveloping");
			c.live[i] = false;
			all_disjoint = all_disjoint0;
		}

		else if stlx or sthx
		{
			// Split in x direction
			//println("straddling +-x");

			// Instead of killing c.[i], we can slot c1 into its place,
			// then decrement i before continuing loop
			let split = a.xhi;
			if (sthx) split = a.xlo;
			const c1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=split   , yhi=c.yhi[i], zhi=c.zhi[i], };
			const c2 = Cube{ xlo=split   , ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, c1);
			i -= 1;
			c.push(c2);
		}

		else if stly or sthy
		{
			// Split in y
			//println("straddling +-y");
			let split = a.yhi;
			if (sthy) split = a.ylo;
			const c1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=split   , zhi=c.zhi[i], };
			const c2 = Cube{ xlo=c.xlo[i], ylo=split   , zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, c1);
			i -= 1;
			c.push(c2);
		}
		else if stlz or sthz
		{
			// Split in z
			//println("straddling +-z");
			let split = a.zhi;
			if (sthz) split = a.zlo;
			const c1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=split   , };
			const c2 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=split   , 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, c1);
			i -= 1;
			c.push(c2);
		}

		else if insx and not envx
		{
			// There should be a way to consolidate this with the straddling
			// case by min/max'ing to push an empty cube
			let spl1 = a.xlo;
			let spl2 = a.xhi;
			const c1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=spl1    , yhi=c.yhi[i], zhi=c.zhi[i], };
			const c2 = Cube{ xlo=spl1    , ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=spl2    , yhi=c.yhi[i], zhi=c.zhi[i], };
			const c3 = Cube{ xlo=spl2    , ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, c1);
			i -= 1;
			c.push(c2);
			c.push(c3);
		}
		else if insy and not envy
		{
			let spl1 = a.ylo;
			let spl2 = a.yhi;
			const c1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=spl1    , zhi=c.zhi[i], };
			const c2 = Cube{ xlo=c.xlo[i], ylo=spl1    , zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=spl2    , zhi=c.zhi[i], };
			const c3 = Cube{ xlo=c.xlo[i], ylo=spl2    , zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, c1);
			i -= 1;
			c.push(c2);
			c.push(c3);
		}
		else if insz and not envz
		{
			let spl1 = a.zlo;
			let spl2 = a.zhi;
			const c1 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=c.zlo[i], 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=spl1    , };
			const c2 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=spl1    , 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=spl2    , };
			const c3 = Cube{ xlo=c.xlo[i], ylo=c.ylo[i], zlo=spl2    , 
			                 xhi=c.xhi[i], yhi=c.yhi[i], zhi=c.zhi[i], };
			c.set(i, c1);
			i -= 1;
			c.push(c2);
			c.push(c3);
		}

		else
		{
			println(ERROR_STR + "unhandled case in add_cube()");
			exit(1);
		}
	}
	if all_disjoint
	{
		// Simply append the added cube to the list
		c.push(a);
	}
	return;
}

fn test_cut(c: Cubes, d: Cube)
{
	// Remove cube `d` from cubes `c` and verify the volume against the
	// brute-force method from part 1

	//println("Testing deletion of d = ", d);
	const xlo = min(minval(c.xlo), d.xlo);
	const ylo = min(minval(c.ylo), d.ylo);
	const zlo = min(minval(c.zlo), d.zlo);
	const xhi = max(maxval(c.xhi), d.xhi);
	const yhi = max(maxval(c.yhi), d.yhi);
	const zhi = max(maxval(c.zhi), d.zhi);
	const nx = xhi - xlo;
	const ny = yhi - ylo;
	const nz = zhi - zlo;
	let g = [false; nx, ny, nz];
	for i in [0: c.n]
		g[
			c.xlo[i] - xlo: c.xhi[i] - xlo,
			c.ylo[i] - ylo: c.yhi[i] - ylo,
			c.zlo[i] - zlo: c.zhi[i] - zlo,
		] = true;
	//println("count(g) = ", count(g));
	g[
		d.xlo - xlo: d.xhi - xlo,
		d.ylo - ylo: d.yhi - ylo,
		d.zlo - zlo: d.zhi - zlo,
	] = false;
	//println("count(g) = ", count(g));
	const vol_expect = count(g);

	cut_cube(&c, d);
	//println("c = ", c);

	// Get vol from bounds only (without `g`) and compare to expected vol
	let vol = 0;
	for i in [0: c.n]
	{
		if (not c.live[i]) continue;
		const inc =
			(c.xhi[i] - c.xlo[i]) *
			(c.yhi[i] - c.ylo[i]) *
			(c.zhi[i] - c.zlo[i]);
		//println("inc = ", inc);
		vol += inc;
	}
	//println("vol = ", vol);
	if vol != vol_expect
	{
		println(ERROR_STR + "bad volume for cube deletion");
		exit(3);
	}
}

fn test_add(c: Cubes, a: Cube)
{
	// Merge added cube `a` into cubes `c` and verify the volume against the
	// brute-force method from part 1

	//println("Testing addition of a = ", a);
	const xlo = min(minval(c.xlo), a.xlo);
	const ylo = min(minval(c.ylo), a.ylo);
	const zlo = min(minval(c.zlo), a.zlo);
	const xhi = max(maxval(c.xhi), a.xhi);
	const yhi = max(maxval(c.yhi), a.yhi);
	const zhi = max(maxval(c.zhi), a.zhi);
	const nx = xhi - xlo;
	const ny = yhi - ylo;
	const nz = zhi - zlo;
	let g = [false; nx, ny, nz];
	for i in [0: c.n]
		g[
			c.xlo[i] - xlo: c.xhi[i] - xlo,
			c.ylo[i] - ylo: c.yhi[i] - ylo,
			c.zlo[i] - zlo: c.zhi[i] - zlo,
		] = true;
	//println("count(g) = ", count(g));
	g[
		a.xlo - xlo: a.xhi - xlo,
		a.ylo - ylo: a.yhi - ylo,
		a.zlo - zlo: a.zhi - zlo,
	] = true;
	//println("count(g) = ", count(g));
	const vol_expect = count(g);

	add_cube(&c, a);
	//println("c = ", c);

	// Get vol from bounds only (without `g`) and compare to expected vol
	let vol = 0;
	for i in [0: c.n]
	{
		if (not c.live[i]) continue;
		const inc =
			(c.xhi[i] - c.xlo[i]) *
			(c.yhi[i] - c.ylo[i]) *
			(c.zhi[i] - c.zlo[i]);
		//println("inc = ", inc);
		vol += inc;
	}
	//println("vol = ", vol);
	if vol != vol_expect
	{
		println(ERROR_STR + "bad volume for cube addition");
		exit(2);
	}
}

fn unit_tests()
{
	let init_cube = Cube{
		xlo = -10, xhi = 10,
		ylo = -10, yhi = 10,
		zlo = -10, zhi = 10,
	};
	let init_cubes = new_cubes();
	//println("init_cubes = ", init_cubes);
	add_cube(&init_cubes, init_cube);
	//println("init_cubes = ", init_cubes);

	// ****************
	// Subtraction tests

	// Enveloping by a lot
	test_cut(init_cubes,
		Cube{xlo = -11, xhi = 11, ylo = -11, yhi = 11, zlo = -11, zhi = 11});

	// Enveloping just barely
	test_cut(init_cubes,
		Cube{xlo = -10, xhi = 10, ylo = -10, yhi = 10, zlo = -10, zhi = 10});

	// Cut whole +x side
	test_cut(init_cubes,
		Cube{xlo = 5, xhi = 15, ylo = -11, yhi = 11, zlo = -11, zhi = 11});
	test_cut(init_cubes,
		Cube{xlo = 5, xhi = 10, ylo = -11, yhi = 11, zlo = -11, zhi = 11});

	// Cut +xyz corner
	test_cut(init_cubes,
		Cube{xlo = 6, xhi = 11, ylo = 7, yhi = 13, zlo = 8, zhi = 15});

	// Cut -xyz corner
	test_cut(init_cubes,
		Cube{xlo = -16, xhi = 1, ylo = -17, yhi = 3, zlo = -18, zhi = 5});

	// Could use more cut unit tests, but i was close enough for an end-to-end
	// test with the sample inputs at this point

	// ****************
	// Addition tests

	// Disjoint, just barely
	test_add(init_cubes,
		Cube{xlo = 10, xhi = 14, ylo = 10, yhi = 15, zlo = 10, zhi = 16});

	// Disjoint, larger gap
	test_add(init_cubes,
		Cube{xlo = 11, xhi = 14, ylo = 12, yhi = 15, zlo = 13, zhi = 16});

	// Disjoint, x only
	test_add(init_cubes,
		Cube{xlo = 10, xhi = 14, ylo = 5, yhi = 15, zlo = 5, zhi = 16});

	// Disjoint, y only
	test_add(init_cubes,
		Cube{xlo = 5, xhi = 14, ylo = 10, yhi = 15, zlo = 5, zhi = 16});

	// Disjoint, z only
	test_add(init_cubes,
		Cube{xlo = 5, xhi = 14, ylo = 5, yhi = 15, zlo = 10, zhi = 16});

	// Added cube inside of initial cube
	test_add(init_cubes,
		Cube{xlo = -3, xhi = 4, ylo = -5, yhi = 6, zlo = -8, zhi = 4});

	// Added cube completely envelopes initial cube
	test_add(init_cubes,
		Cube{xlo = -12, xhi = 13, ylo = -14, yhi = 15, zlo = -16, zhi = 17});

	// Attached inside of -x face
	test_add(init_cubes,
		Cube{xlo = -12, xhi = 5, ylo = -4, yhi = 5, zlo = -6, zhi = 7});

	// Attached inside of -y face
	test_add(init_cubes,
		Cube{xlo = -2, xhi = 5, ylo = -14, yhi = 5, zlo = -6, zhi = 7});

	// Attached inside of -z face
	test_add(init_cubes,
		Cube{xlo = -2, xhi = 5, ylo = -4, yhi = 5, zlo = -16, zhi = 7});

	// Attached inside of +x face
	test_add(init_cubes,
		Cube{xlo = -2, xhi = 15, ylo = -4, yhi = 5, zlo = -6, zhi = 7});

	// Attached inside of +y face
	test_add(init_cubes,
		Cube{xlo = -2, xhi = 5, ylo = -4, yhi = 15, zlo = -6, zhi = 7});

	// Attached inside of +z face
	test_add(init_cubes,
		Cube{xlo = -2, xhi = 5, ylo = -4, yhi = 5, zlo = -6, zhi = 17});

	// Attached outside of -x face
	test_add(init_cubes,
		Cube{xlo = -12, xhi = 5, ylo = -14, yhi = 15, zlo = -16, zhi = 17});

	// Attached outside of -y face
	test_add(init_cubes,
		Cube{xlo = -12, xhi = 15, ylo = -14, yhi = 5, zlo = -16, zhi = 17});

	// Attached outside of -z face
	test_add(init_cubes,
		Cube{xlo = -12, xhi = 15, ylo = -14, yhi = 15, zlo = -16, zhi = 7});

	// Attached outside of +xyz faces respectively
	test_add(init_cubes,
		Cube{xlo = 2, xhi = 15, ylo = -14, yhi = 15, zlo = -16, zhi = 17});
	test_add(init_cubes,
		Cube{xlo = -12, xhi = 15, ylo = 4, yhi = 15, zlo = -16, zhi = 17});
	test_add(init_cubes,
		Cube{xlo = -12, xhi = 15, ylo = -14, yhi = 15, zlo = 6, zhi = 17});

	// Interlocked cases, e.g. `stlx and insy and envz`
	//println("interlock 1");
	test_add(init_cubes,  // stlx and insy and envz
		Cube{xlo = -12, xhi = 5, ylo = -4, yhi = 5, zlo = -16, zhi = 17});
	test_add(init_cubes,  // insx and envy and sthz
		Cube{xlo = -2, xhi = 5, ylo = -14, yhi = 15, zlo = -6, zhi = 17});
	test_add(init_cubes,  // envx and sthy and insz
		Cube{xlo = -12, xhi = 15, ylo = -4, yhi = 15, zlo = -6, zhi = 7});

	// Inside of +x+y edge
	test_add(init_cubes,
		Cube{xlo = 5, xhi = 15, ylo = 4, yhi = 14, zlo = -6, zhi = 7});

	// Inside of -x+y edge
	test_add(init_cubes,
		Cube{xlo = -15, xhi = 5, ylo = 4, yhi = 14, zlo = -6, zhi = 7});

	// Inside of +x-y edge
	test_add(init_cubes,
		Cube{xlo = 5, xhi = 15, ylo = -14, yhi = 4, zlo = -6, zhi = 7});

	// Inside of -x-y edge
	test_add(init_cubes,
		Cube{xlo = -15, xhi = 5, ylo = -14, yhi = 4, zlo = -6, zhi = 7});

	test_add(init_cubes,  // envx and insy and insz
		Cube{xlo = -15, xhi = 15, ylo = -4, yhi = 4, zlo = -6, zhi = 7});
	test_add(init_cubes,  // envx and envy and insz
		Cube{xlo = -15, xhi = 15, ylo = -14, yhi = 14, zlo = -6, zhi = 7});
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;
	unit_tests();

	let c = new_cubes();
	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	let kk = 0;
	while not eof(f)
	{
		//println("str_ = ", str_);

		let nums = parse_i32_delim(str_, "onff xyz=.,");
		//println("nums = ", nums);
		const xmin = nums[0];
		const xmax = nums[1]+1;
		const ymin = nums[2];
		const ymax = nums[3]+1;
		const zmin = nums[4];
		const zmax = nums[5]+1;

		const is_on = starts_with_(str_, "on");

		str_ = readln(f);
		//println("kk = ", kk);
		kk += 1;

		let a = Cube{
			xlo = xmin, xhi = xmax,
			ylo = ymin, yhi = ymax,
			zlo = zmin, zhi = zmax,
		};
		if is_on
			add_cube(&c, a);
		else
			cut_cube(&c, a);
	}
	close(f);
	println("number of divided cubes = ", c.n);
	println("number of live cubes    = ", count(c.live[0:c.n]));
	for i in [0: c.n]
	{
		if (not c.live[i]) continue;
		sum_ +=
			i64(c.xhi[i] - c.xlo[i]) *
			(c.yhi[i] - c.ylo[i]) *
			(c.zhi[i] - c.zlo[i]);
	}

	println("part 2 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2021/22" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "543306";
	let expect2 = "1285501151402480";
	let expect1_test = "474140";  // actually part 2's test input
	let expect2_test = "2758514936282235";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

