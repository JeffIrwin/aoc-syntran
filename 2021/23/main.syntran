
use ../../utils::*;
use ../../dict_i64_2026 as dict_i64;
use ../../queue_vec_i32 as queue_vec_i32;
use ../../minheap_vec_i32_2026 as minheap_vec_i32;

//==============================================================================

fn part1(args: &const Args): str
{
	let g0 = read_char_mat(args.input_filename);
	print_char_mat(&g0);

	const sum_ = do_it(&args, &g0, 1);
	println("part 1 = ", sum_);
	return str(sum_);
}

fn do_it(args: &const Args, g0: &[str; :,:], ipart: i32): i64
{
	let sum_ = 2_000_000_000'i64;

	const nx = i32(size(g0,0));
	const ny = i32(size(g0,1));
	const nt = 4;  // number of types of amphipods
	const npt = i32(count(g0 == "A"));  // number of amphipods per type: 2 or 4
	const n = nt * npt;  // total number of amphipods

	// Get positions `p` from grid `g0`
	let p = [0; 2, n];
	let na = [0; nt];
	for y in [0: ny]
	for x in [0: nx]
	{
		if (g0[x,y] == "") g0[x,y] = " ";
		const c = g0[x,y];
		if not is_alpha(c) continue;
		const it = i32(c) - i32("A"); // type index: 0 for A, 1 for B, ...
		const ii = na[it];
		println("x, y, it = ", [x, y, it]);

		p[0, npt*it + ii] = x;
		p[1, npt*it + ii] = y;
		na[it] += 1;
	}
	println("p = ", p);
	const pinit = p;
	let pv = std::reshape(p, [2 * n]);
	println("pv = ", pv);

	// Make a blank copy of the map grid with amphipods replaced with "."
	let gb = g0;
	for y in [0: ny]
	for x in [0: nx]
		if is_alpha(g0[x,y])
			gb[x,y] = ".";

	// Set of legal positions, excluding spaces immediately outside any room
	let is_legal = [true; nx, ny];
	is_legal[[3 + 2*[0:4]], 1] = false;
	//println("is_legal = ", is_legal);

	let energy = dict_i64::new();
	let dists = [-1; nx, ny];
	let g = [""; nx, ny];
	let gn = g;
	let p0 = pv;

	// Energy per step for each amphipod type
	const eps = [1, 10, 100, 1000];

	// The state is the energy consumed so far, all current positions, and an
	// integer for whether each piece has moved at all yet
	const state0 = [[0], pv];

	const key0 = char_mat_to_str(g0[1:nx-1, 1:ny-1]);
	////const key0 = cat_strs([g0[1:nx-1,1], g0[3:2:nx-2, 2:ny-1]]);
	//const key0 = cat_strs([g0[1:nx-1,1], g0[3:2:nx-2, 2], g0[3:2:nx-2,3]]);
	println("key0 = ");
	println(key0);
	//exit(0);

	energy.set(key0, 0'i64);
	let q = minheap_vec_i32::new();
	q.push(state0);
	let kk = 0;
	while true
	{
		if (q.len == 0) break;
		const u = q.pop();
		const e0 = u[0];
		//p0 = std::reshape(u[1: 2*n+1], [2, n]);  // positions
		p0 = u[1: 2*n+1];  // positions
		kk += 1;
		get_grid(&gb, &p0, npt, &g);
		if (kk % 3000 == 0)
		{
			println("e0, sum_ = ", [e0, i32(sum_)]);
			print_char_mat(&g);
		}
		let all_home = true;
		let nhome = 0;
		for ip in [0: n]
		{
			const it = ip / npt;
			const px = p0[2*ip+0];
			const py = p0[2*ip+1];
			const is_home  = px == 3 + it * 2 and py >= 2; // at destination?
			if (is_home) nhome += 1;
			all_home = all_home and is_home;
		}
		if all_home
		{
			sum_ = min(sum_, i64(e0));
			continue;
		}

		for ip in [0: n]
		{
			const it = ip / npt;
			const ty = char(it + i32("A"));
			const px = p0[2*ip+0];
			const py = p0[2*ip+1];

			const is_start = all([px,py] == pinit[:,ip]);
			const is_home  = px == 3 + it * 2 and py >= 2; // at destination?
			if is_home and not is_start
				continue;
			if is_home and g[px,py-1] != "."
				continue;  // blocked above

			get_dists(&g, &p0, ip, &dists);
			let xmin = 3;
			let xmax = nx-2;
			let dx = 2;
			let ymin = 2;
			let ymax = ny-1;
			if is_start
			{
				xmin = 1;
				xmax = nx-1;
				dx = 1;
				ymin = 1;
				ymax = 2;
			}

			for y in [ymin: ymax]
			for x in [xmin: dx: xmax]
			{
				if (not is_legal[x,y]) continue;
				if (dists[x,y] <= 0) continue;

				// Enforce not moving home if another type is below us in our
				// home. Need to build g? Or at least the bottom row?
				if (not is_start and y == 2 and g[x,3] != ty) continue;
				if ipart == 2
				{
					if (not is_start and y == 2 and g[x,4] != ty) continue;
					if (not is_start and y == 2 and g[x,5] != ty) continue;
					if (not is_start and y == 3 and g[x,4] != ty) continue;
					if (not is_start and y == 3 and g[x,5] != ty) continue;
					if (not is_start and y == 4 and g[x,5] != ty) continue;
				}

				//p = p0;
				//p[:, ip] = [x, y];
				//pv = std::reshape(p, [2 * n]);
				pv = p0;
				pv[2*ip+0] = x;
				pv[2*ip+1] = y;

				// Swap two chars instead of building from scratch. No perf
				// difference
				gn = g;
				gn[px,py] = ".";
				gn[ x, y] = ty;

				const key = char_mat_to_str(gn[1:nx-1, 1:ny-1]);
				//const key = cat_strs([gn[1:nx-1,1], gn[3:2:nx-2, 2], gn[3:2:nx-2,3]]);

				const e = energy.get(key);
				const ealt = e0 + dists[x,y] * eps[it];

				if e < 0 or ealt < e
				{
					energy.set(key, i64(ealt));
					q.push([[ealt], pv]);
				}
			}
		}
	}
	return sum_;
}

fn part2(args: &const Args): str
{
	const ins1 = "  #D#C#B#A#";
	const ins2 = "  #D#B#A#C#";

	const g00 = read_char_mat(args.input_filename);
	print_char_mat(&g00);

	let gt = g00[:, 0:3];
	let v1 = vec_str(ins1);
	let v2 = vec_str(ins2);
	let gd = g00[:, 3: ];
	println("gd = ");
	print_char_mat(&gd);

	let g0 = [""; 13, 7];
	g0[:, 0:3] = gt;
	g0[0: size(v1), 3] = v1;
	g0[0: size(v2), 4] = v2;
	g0[:, 5:] = gd;
	print_char_mat(&g0);

	const sum_ = do_it(&args, &g0, 2);
	println("part 2 = ", sum_);
	return str(sum_);
}

const nd = 4;
const dirs = [
	1, 0,
	-1, 0,
	0, 1,
	0, -1
	;
	2, 4
];

fn get_grid(gb: &const [str; :,:], p0: &const [i32; :], npt: i32, g: &[str; :,:])
{
	// Fill in current positions
	g = gb;
	const np = i32(size(p0)) / 2;
	for i in [0: np]
	{
		const it = i / npt;
		const ty = char(it + i32("A"));
		//g[p0[0,i], p0[1,i]] = ty;
		g[p0[2*i+0], p0[2*i+1]] = ty;
	}
	return;
}

fn get_dists
	(
		g: &const [str; :,:], p0: &const [i32; :], ip: i32,
		dists: &[i32; :,:]
	)
{
	// Do a BFS from the position at index `ip` and return the distances to all
	// reachable points. Set negative distances for unreachable points
	//
	// The grid is changing throughout the organization process, so the set of
	// reachable points changes, hence we can't just call this once at
	// initialization
	//
	// Distance here is just literal distance. Note that in the caller, the
	// "distance" that we care about minimizing for Dijkstra is actually energy
	dists = -1;
	const nx = i32(size(g,0));
	const ny = i32(size(g,1));
	const np = i32(size(p0)) / 2;

	// BFS is overkill. Moves are limited, we only need to calculate start
	// to top row, and then top row to home
	const x0 = p0[2*ip+0];
	const y0 = p0[2*ip+1];
	if y0 >= 2
	{
		let y = y0;
		let d = 0;
		while true
		{
			dists[x0,y] = d;
			y -= 1;
			d += 1;
			if (g[x0,y] != ".") return;
			if (y == 1) break;
		}

		let x = x0;
		let d0 = d;
		while true
		{
			dists[x,y] = d;
			if (x == 1) break;
			x -= 1;
			d += 1;
			if (g[x,y] != ".") break;
		}
		x = x0;
		d = d0;
		while true
		{
			dists[x,y] = d;
			if (x == nx-2) break;
			x += 1;
			d += 1;
			if (g[x,y] != ".") break;
		}
		//println("dists = ", dists);
		return;
	}

	// queue-free BFS for the other case
	const it = i32(g[x0,y0]) - i32("A"); // type index: 0 for A, 1 for B, ...
	const xt = 3 + 2 * it;
	let dx = 1;
	if (xt < x0) dx = -1;
	let x = x0;
	let d = 0;
	while true
	{
		dists[x,y0] = d;
		x += dx;
		d += 1;
		if (g[x,y0] != ".") return;
		if (x == xt) break;
	}
	let y = y0;
	while true
	{
		if (g[x,y] != ".") break;
		dists[x,y] = d;
		y += 1;
		d += 1;
	}
	//print_char_mat(&g);
	//println("dists = ", dists);
	//exit(0);
	return;
}

