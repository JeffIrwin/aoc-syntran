
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let lines = read_i32_mat_delim(args.input_filename, ", ->");
	//println("lines = ", lines);

	let xmax = maxval(lines[[0,2], :]) + 1;
	let ymax = maxval(lines[[1,3], :]) + 1;
	//println("xy max = ", [xmax, ymax]);

	let counts = [0; xmax, ymax];
	for il in [0: size(lines,1)]
	{
		let line = lines[:,il];
		//println("line = ", line);
		let x1 = line[0];
		let y1 = line[1];
		let x2 = line[2];
		let y2 = line[3];
		if x1 == x2
		{
			y1 = minval(line[[1,3]]);
			y2 = maxval(line[[1,3]]);
			counts[x1, y1:y2+1] += 1;
		}
		if y1 == y2
		{
			x1 = minval(line[[0,2]]);
			x2 = maxval(line[[0,2]]);
			counts[x1:x2+1, y1] += 1;
		}
	}
	//println("counts = ", counts);

	sum_ = count(counts >= 2);
	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let lines = read_i32_mat_delim(args.input_filename, ", ->");

	let xmax = maxval(lines[[0,2], :]) + 1;
	let ymax = maxval(lines[[1,3], :]) + 1;

	let counts = [0; xmax, ymax];
	for il in [0: size(lines,1)]
	{
		let line = lines[:,il];
		let x1 = line[0];
		let y1 = line[1];
		let x2 = line[2];
		let y2 = line[3];
		if x1 == x2
		{
			y1 = minval(line[[1,3]]);
			y2 = maxval(line[[1,3]]);
			counts[x1, y1:y2+1] += 1;
		}
		else if y1 == y2
		{
			x1 = minval(line[[0,2]]);
			x2 = maxval(line[[0,2]]);
			counts[x1:x2+1, y1] += 1;
		}
		else
		{
			let dx = sign_(x2-x1);
			let dy = sign_(y2-y1);
			let x = x1;
			let y = y1;
			for d in [0: abs(x2-x1)+1]
			{
				counts[x,y] += 1;
				x += dx;
				y += dy;
			}
		}
	}
	//println("counts = ", counts);

	sum_ = count(counts >= 2);
	println("part 2 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2025/5" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "5145";
	let expect2 = "16518";
	let expect1_test = "5";
	let expect2_test = "12";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

