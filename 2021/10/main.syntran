
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let s = readln(f);
	while not eof(f)
	{
		//println("s = ", s);

		let stack = s;
		let sp = 0;
		for c in s
		{
			if any(c == ["(", "[", "{", "<"])
			{
				// Push
				stack[sp] = c;
				sp += 1;
			}
			else
			{
				// Pop and match
				sp -= 1;
				let pop = stack[sp];
				//if c != pop
				if not (
					(pop == "(" and c == ")") or
					(pop == "[" and c == "]") or
					(pop == "{" and c == "}") or
					(pop == "<" and c == ">")
					)
				{
					//println("Expected ", pop, ", found ", c);
					if (c == ")") sum_ += 3;
					if (c == "]") sum_ += 57;
					if (c == "}") sum_ += 1197;
					if (c == ">") sum_ += 25137;
					break;
				}
			}
		}
		s = readln(f);
	}
	close(f);

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let s = readln(f);
	let scores = [0'i64; 128];
	let k = 0;
	while not eof(f)
	{
		let stack = s;
		let sp = 0;
		let corrupt = false;
		for c in s
		{
			if any(c == ["(", "[", "{", "<"])
			{
				// Push
				stack[sp] = c;
				sp += 1;
			}
			else
			{
				// Pop and match
				sp -= 1;
				let pop = stack[sp];
				if not (
					(pop == "(" and c == ")") or
					(pop == "[" and c == "]") or
					(pop == "{" and c == "}") or
					(pop == "<" and c == ">")
				)
				{
					corrupt = true;
					break;
				}
			}
		}
		if not corrupt
		{
			// Incomplete
			let score = 0'i64;
			while sp > 0
			{
				sp -= 1;
				let pop = stack[sp];
				if (pop == "(") score = 5*score + 1;
				if (pop == "[") score = 5*score + 2;
				if (pop == "{") score = 5*score + 3;
				if (pop == "<") score = 5*score + 4;
			}
			//println("score = ", score);
			scores[k] = score;
			k += 1;
		}
		s = readln(f);
	}
	close(f);
	scores = scores[0:k];
	sort_inplace_i64(&scores);
	sum_ = scores[size(scores)/2];

	println("part 2 = ", sum_);
	return str(sum_);
}

