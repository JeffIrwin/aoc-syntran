
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	//println("str_ = ", str_);
	close(f);

	// Convert hex to binary as a vector of 0 or 1 ints. Not memory efficient
	// but fine for AOC. A (character) string of "0" and "1" could also work
	// with 4x less memory but more work for converting strings to ints

	const nv = 4 * len(str_); // 4 bits per hex nibble
	let v = [0; nv];
	let iv = 0;
	for i in [0: len(str_)]
	{
		const hex = i32(index_(hex_chars, to_lower(str_[i])));
		//println("str_[i] = ", str_[i]);
		//println("hex     = ", hex);
		v[iv+0] = hex >> 3 & 1;
		v[iv+1] = hex >> 2 & 1;
		v[iv+2] = hex >> 1 & 1;
		v[iv+3] = hex >> 0 & 1;
		iv += 4;
	}
	//println("v = ", to_bit_str(v));
	//println();

	// D2FE28 becomes:
	// 110100101111111000101000
	// VVVTTTAAAAABBBBBCCCCC

	iv = 0;
	parse_packet1(&v, &iv, &sum_);

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	close(f);

	const nv = 4 * len(str_); // 4 bits per hex nibble
	let v = [0; nv];
	let iv = 0;
	for i in [0: len(str_)]
	{
		const hex = i32(index_(hex_chars, to_lower(str_[i])));
		v[iv+0] = hex >> 3 & 1;
		v[iv+1] = hex >> 2 & 1;
		v[iv+2] = hex >> 1 & 1;
		v[iv+3] = hex >> 0 & 1;
		iv += 4;
	}

	iv = 0;
	parse_packet(&v, &iv, &sum_);

	println("part 2 = ", sum_);
	return str(sum_);
}

fn parse_packet(v: &const [i32; :], iv: &i32, outval: &i64)
{
	const vb = v[iv: iv+3];  // version bits
	const vers = to_int(vb);
	iv += 3;

	const tb = v[iv: iv+3];  // type id bits
	const ty = to_int(tb);
	iv += 3;

	if ty == 4
	{
		// Parse literal value packet
		let lit = 0'i64;
		while true
		{
			const prefix = v[iv];
			iv += 1;
			for i in [0: 4]
			{
				lit = (lit << 1) | i64(v[iv]);
				iv += 1;
			}
			if (prefix == 0) break;
		}
		outval = lit;
	}
	else
	{
		// Parse operator packet
		let len_id = v[iv];
		let len_bits = 0;
		let len_subs = 0;
		iv += 1;
		let subvals = [0'i64; 0];
		if len_id == 0
		{
			// 15-bit total length in bits of sub-packets
			len_bits = to_int(v[iv: iv+15]);
			iv += 15;
			const iv0 = iv;
			while iv - iv0 != len_bits
			{
				let subval = 0'i64;
				parse_packet(&v, &iv, &subval);
				subvals = [subvals, [subval]]; // bad amortization
			}
		}
		else
		{
			// 11-bit number of sub-packets
			len_subs = to_int(v[iv: iv+11]);
			iv += 11;
			let nsub = 0;
			while true
			{
				let subval = 0'i64;
				parse_packet(&v, &iv, &subval);
				subvals = [subvals, [subval]]; // bad amortization
				nsub += 1;
				if (nsub == len_subs) break;
			}
		}
		//println("subvals = ", subvals);
		outval = 0;
		if ty == 0
			outval = sum(subvals);
		else if ty == 1
			outval = product(subvals);
		else if ty == 2
			outval = minval(subvals);
		else if ty == 3
			outval = maxval(subvals);
		else if ty == 5 and (subvals[0] > subvals[1])
			outval = 1;
		else if ty == 6 and (subvals[0] < subvals[1])
			outval = 1;
		else if ty == 7 and (subvals[0] == subvals[1])
			outval = 1;
	}
	return;
}

fn parse_packet1(v: &const [i32; :], iv: &i32, sum_: &i64)
{
	const vb = v[iv: iv+3];  // version bits
	const vers = to_int(vb);
	iv += 3;

	// Part 1 only
	sum_ += vers;

	const tb = v[iv: iv+3];  // type id bits
	const ty = to_int(tb);
	iv += 3;

	//println("vb = ", vb);
	//println("tb = ", tb);
	//println("vers = ", vers);
	//println("ty   = ", ty);

	if ty == 4
	{
		// Parse literal value packet
		let lit = 0'i64;
		while true
		{
			const prefix = v[iv];
			iv += 1;
			for i in [0: 4]
			{
				lit = (lit << 1) | i64(v[iv]);
				iv += 1;
			}
			if (prefix == 0) break;
		}
		//println("lit = ", lit);
	}
	else
	{
		// Parse operator packet
		let len_id = v[iv];
		let len_bits = 0;
		let len_subs = 0;
		iv += 1;
		if len_id == 0
		{
			// 15-bit total length in bits of sub-packets
			len_bits = to_int(v[iv: iv+15]);
			iv += 15;
			//println("len_bits = ", len_bits);
			//println();
			const iv0 = iv;
			while iv - iv0 != len_bits
				parse_packet1(&v, &iv, &sum_);
		}
		else
		{
			// 11-bit number of sub-packets
			len_subs = to_int(v[iv: iv+11]);
			iv += 11;
			//println("len_subs = ", len_subs);
			//println();
			let nsub = 0;
			while true
			{
				parse_packet1(&v, &iv, &sum_);
				nsub += 1;
				if (nsub == len_subs) break;
			}
		}
	}
	//println();
	return;
}

fn to_int(v: &const [i32; :]): i64
{
	// Convert binary to i64, where v represents binary by an array of 0 or 1
	// i32's
	let i = 0'i64;
	let shift_ = size(v);
	for vv in v
	{
		shift_ -= 1;
		i |= i64(vv) << shift_;
	}
	return i;
}

fn to_bit_str(v: &const [i32; :]): str
{
	// Input v is an array of 0's and 1's
	let s = repeat(" ", i32(size(v)));
	for i in [0: size(v)]
		s[i] = str(v[i]);
	return s;
}

