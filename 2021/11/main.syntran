
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let gc = read_char_mat(args.input_filename);
	const NX = i32(size(gc, 0));
	const NY = i32(size(gc, 1));
	let g = [0; NX, NY];
	for y in [0: NY]
	for x in [0: NX]
		g[x,y] = parse_i32(gc[x,y]);
	//println("g = ", g);

	for k in [0: 100]
	{
		g += 1;
		while true
		{
			let any_flash = false;
			for y in [0: NY]
			for x in [0: NX]
			{
				if (g[x,y] <= 9) continue;
				any_flash = true;
				let xl = max(x-1, 0);
				let xh = min(x+2, NX);
				let yl = max(y-1, 0);
				let yh = min(y+2, NY);
				//g[xl:xh, yl:yh] += 1;
				for yn in [yl: yh]
				for xn in [xl: xh]
					if g[xn,yn] != 0 // can't flash more than once per step
						g[xn,yn] += 1;
				g[x,y] = 0;
				sum_ += 1;
			}
			if (not any_flash) break;
		}
		//println("g = ", g);
	}
	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let gc = read_char_mat(args.input_filename);
	const NX = i32(size(gc, 0));
	const NY = i32(size(gc, 1));
	let g = [0; NX, NY];
	for y in [0: NY]
	for x in [0: NX]
		g[x,y] = parse_i32(gc[x,y]);

	let k = 0;
	while true
	{
		g += 1;
		while true
		{
			let any_flash = false;
			for y in [0: NY]
			for x in [0: NX]
			{
				if (g[x,y] <= 9) continue;
				any_flash = true;
				let xl = max(x-1, 0);
				let xh = min(x+2, NX);
				let yl = max(y-1, 0);
				let yh = min(y+2, NY);
				for yn in [yl: yh]
				for xn in [xl: xh]
					if g[xn,yn] != 0 // can't flash more than once per step
						g[xn,yn] += 1;
				g[x,y] = 0;
			}
			if (not any_flash) break;
		}
		k += 1;
		if all(g == 0) break;
	}
	sum_ = k;

	println("part 2 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2021/11" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "1546";
	let expect2 = "471";
	let expect1_test = "1656";
	let expect2_test = "195";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

