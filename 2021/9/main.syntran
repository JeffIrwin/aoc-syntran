
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let gc = read_char_mat(args.input_filename);
	const NX = size(gc, 0);
	const NY = size(gc, 1);
	let g = [0; NX, NY];
	for y in [0: NY]
	for x in [0: NX]
		g[x,y] = parse_i32(gc[x,y]);
	//println("g = ", g);

	for y in [0: NY]
	for x in [0: NX]
	{
		let xw = x-1;
		let xe = x+1;
		let ys = y-1;
		let yn = y+1;
		let is_low = true;
		if (xw >= 0) is_low = is_low and g[x,y] < g[xw,y];
		if (xe < NX) is_low = is_low and g[x,y] < g[xe,y];
		if (ys >= 0) is_low = is_low and g[x,y] < g[x,ys];
		if (yn < NY) is_low = is_low and g[x,y] < g[x,yn];
		if is_low
		{
			//println("low at ", [x,y]);
			sum_ += g[x,y] + 1;
		}
	}

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	let gc = read_char_mat(args.input_filename);
	const NX = i32(size(gc, 0));
	const NY = i32(size(gc, 1));
	let g = [0; NX, NY];
	for y in [0: NY]
	for x in [0: NX]
		g[x,y] = parse_i32(gc[x,y]);
	//println("g = ", g);

	let basin_size = [0; NX * NY];
	let k = 0;
	for y in [0: NY]
	for x in [0: NX]
	{
		let seen = [false; NX, NY];
		let xw = x-1;
		let xe = x+1;
		let ys = y-1;
		let yn = y+1;
		let is_low = true;
		if (xw >= 0) is_low = is_low and g[x,y] < g[xw,y];
		if (xe < NX) is_low = is_low and g[x,y] < g[xe,y];
		if (ys >= 0) is_low = is_low and g[x,y] < g[x,ys];
		if (yn < NY) is_low = is_low and g[x,y] < g[x,yn];
		if is_low
		{
			dfs(&g, &seen, x, y);
			basin_size[k] = count(seen);
			k += 1;
		}
	}
	//println("basin_size = ", basin_size);
	basin_size = sort_inplace(basin_size[:k]);
	basin_size = basin_size[:-1:];
	//println("basin_size = ", basin_size);
	sum_ = product(basin_size[0:3]);

	println("part 2 = ", sum_);
	return str(sum_);
}

fn dfs(g: &const [i32; :,:], seen: &[bool; :,:], x: i32, y: i32)
{
	if (seen[x,y]) return;
	seen[x,y] = true;

	const NX = size(g,0);
	const NY = size(g,1);
	let xw = x-1;
	let xe = x+1;
	let ys = y-1;
	let yn = y+1;
	if (xw >= 0) if (g[xw,y] != 9) dfs(&g, &seen, xw, y);
	if (xe < NX) if (g[xe,y] != 9) dfs(&g, &seen, xe, y);
	if (ys >= 0) if (g[x,ys] != 9) dfs(&g, &seen, x, ys);
	if (yn < NY) if (g[x,yn] != 9) dfs(&g, &seen, x, yn);

	return;
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2021/9" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "489";
	let expect2 = "1056330";
	let expect1_test = "15";
	let expect2_test = "1134";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

