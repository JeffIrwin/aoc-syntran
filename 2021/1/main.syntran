
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let v = read_i32_mat(args.input_filename)[0,:];
	let n = size(v);
	//println("v = ", v);

	sum_ = count(v[1:] - v[:n-1] > 0);
	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	let v = read_i32_mat(args.input_filename)[0,:];
	let n = size(v);
	//println("v = ", v);

	//sum_ = count(v[1:] - v[:n-1] > 0);

	let nw = 3; // window size
	let vf = [0; n-nw+1];
	for i in [0: size(vf)]
		vf[i] = sum(v[i: i+nw]);
	sum_ = count(vf[1:] - vf[:size(vf)-1] > 0);

	println("part 2 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2021/1" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "1759";
	let expect2 = "1805";
	let expect1_test = "7";
	let expect2_test = "5";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

//==============================================================================

