
use ../../utils::*;
use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn get_rot_mats(): [i32; :,:,:]
{
	// Return an array of rotation matrices for all 24 ways to symmetrically
	// orient a cube
	let r = [0; 3, 3, 24];

	let eps = [-1; 3, 3]; // epsilon permutation symbol
	eps[0,1] = 2;
	eps[1,2] = 0;
	eps[2,0] = 1;
	eps[1,0] = 2;
	eps[2,1] = 0;
	eps[0,2] = 1;

	let k = 0;
	for i0 in [0: 3]
	for i1 in [0: 3]
	{
		if (i0 == i1) continue;
		const i2 = eps[i0,i1];
		for s0 in [1, -1]
		for s1 in [1, -1]
		{
			r[0,i0,k] = s0;
			r[1,i1,k] = s1;
			r[2,:,k] = cross(r[0,:,k], r[1,:,k]);
			k += 1;
		}
	}
	return r;
}

fn cross(a: [i32;:], b: [i32;:]): [i32;:]
{
	let c = [0;3];
	c[0] = a[1] * b[2] - a[2] * b[1];
	c[1] = a[2] * b[0] - a[0] * b[2];
	c[2] = a[0] * b[1] - a[1] * b[0];
	return c;
}

fn both_parts(args: &const Args, p1: &str, p2: &str)
{
	let sum_ = 0'i64;

	let lines = readlns_(args.input_filename);
	let ns = 0;
	for line in lines
		if starts_with_(line, "---")
			ns += 1;
	println("ns = ", ns);

	let nbps = [0; ns]; // beacons per scanner (not uniform)
	let is = -1;
	for line in lines
		if starts_with_(line, "---")
			is += 1;
		else if line == ""
		{
			// no-op
		}
		else
			nbps[is] += 1;
	const nbmax = maxval(nbps);
	println("nbps  = ", nbps);
	println("nbmax = ", nbmax);

	// Relative beacon positions from report
	let d = [0; 3, nbmax, ns];
	is = -1;
	let ib =  0;
	for line in lines
		if starts_with_(line, "---")
		{
			is += 1;
			ib = 0;
		}
		else if line == ""
		{
			// no-op
		}
		else
		{
			d[:, ib, is] = parse_i32_delim(line, ",");
			ib += 1;
		}
	const r = get_rot_mats();
	//println("d = ", d);

	// Start with only the scanner 0 fixed
	let fixed = [false; ns];
	fixed[0] = true;
	let tried = [false; ns, ns];
	let maybe = [false; ns, ns];
	let pos = [0; 3, ns];

	// Save all possible rotations ahead of time
	let dr = [0; 3, nbmax, ns, 24];
	for is in [0: ns]
	for ir in [0: 24]
		dr[:,:,is,ir] = r[:,:,ir] @ d[:,:,is];

	let ifree  = [1: ns];
	let nfree  = ns-1;
	let ifixed = [0];
	let nfixed = 1;
	let ncon = [0; ns];  // not used, but it helps show the graph structure

	// Use simplex fingerprints to prune search space. Wasn't initially sure
	// whether tris or tets will perform better. Tets are even more work up
	// front compared to tris, but prune better for a faster search later. Line
	// segments could also work
	//
	// - no fingerprinting takes: 592 s
	// - tri fingerprints take:   112 s
	// - tet fingerprints take:   120 s -- too much up front
	// - tri plus nshared count:   27 s

	// Max number of triangles or tets
	const ntmax = (nbmax-0) * (nbmax-1) * (nbmax-2) / (3 * 2 * 1);
	println("ntmax = ", ntmax);
	let tets = [""; ntmax, ns];
	let ntps = [0; ns];
	for is in [0: ns]
	{
		let nb = nbps[is];
		let nt = 0;
		for i0 in [0: nb]
		for i1 in [i0+1: nb]
		for i2 in [i1+1: nb]
		{
			// Save simplices by sorted edge lengths. This is invariant to
			// transformations and is thus a sufficient fingerprint
			let e01 = sum(abs(d[:,i0,is] - d[:,i1,is]));
			let e12 = sum(abs(d[:,i1,is] - d[:,i2,is]));
			let e20 = sum(abs(d[:,i2,is] - d[:,i0,is]));

			let edges = sort_inplace([e01, e12, e20]);

			tets[nt,is] = str(edges);
			nt += 1;
		}
		//println("nt = ", nt);
		ntps[is] = nt;
	}
	println("ntps = ", ntps);

	// Use tet hash sets to determine "maybe" possible connections
	for i in [0: ns]
	{
		println("simplex ", i, " / ", ns);
		let iset = dict_i64::new();
		for ki in [0: ntps[i]]
			iset.set(tets[ki,i], 1'i64);

		for j in [i+1: ns]
		{
			if maybe[i,j] break;
			let nshared = 0;
			for kj in [0: ntps[j]]
				if iset.contains(tets[kj,j])
				{
					nshared += 1;
					if nshared >= (12 * 11 * 10) / (3 * 2 * 1)
					{
						// 12 common vertices will result in this many common
						// triangles
						maybe[i,j] = true;
						maybe[j,i] = true;
					}
				}
		}
	}
	println("maybe = ", count(maybe), " / ", size(maybe));

	// idk if all these loops are necessary but i went crazy because there was a
	// bug in get_rot_mats
	while true
	{
	if all(fixed) break;

	// Find free scanner j which overlaps with fixed scanner i
	for ifi in [0: nfixed]
	{
	let i = ifixed[ifi];
	//if (ncon[i] == 2) {println("cycling ..."); continue; }

	// Would it help to save an array of hash sets ahead of time? It would have
	// to be as each scanner is fixed
	let iset = dict_i64::new();
	for ki in [0: nbps[i]]
		iset.set(str(d[:,ki,i]), 1'i64);

	for jfr in [0: nfree]
	{
		let j = ifree[jfr];
		if not maybe[i,j] continue;
		if all(fixed) break;
		if tried[i,j] continue;
		tried[i,j] = true;
		//println("i, j = ", [i, j]);

		// Try all rotations of scanner j
		for jr in [0: 24]
		{
			// Apply rotation. Might be faster if we save all rotations ahead of
			// time before nested loop
			const dj = dr[:,:,j,jr];

			// Try collocating beacon ii of scanner i with beacon jj of scanner
			// j and then count how many other beacons overlap. This search is
			// O(26**2), where ~26 is nbmax, as opposed to O(2000**3) of trying
			// every beacon location within its detection cube
			//
			// If you tracked which vertices created shared fingerprint
			// triangles, you could speed up this part a bit
			for ii in [0: nbps[i]]
			for jj in [0: nbps[j]]
			{
				if fixed[j] break;

				// Translation from ii to jj
				const t = -(dj[:,jj] - d[:,ii,i]);

				// Apply translation
				let tj = dj;
				for k in [0: 3]
					tj[k,:] += t[k];

				// Count overlaps using a hash set
				let no = 0;
				let nnon = 0;
				let n = nbps[j];
				for kj in [0: n]
				{
					if iset.contains(str(tj[:,kj]))
					{
						no += 1;
						if (no >= 12) break;
					}
					else
					{
						nnon += 1;
						// Break early if too many not overlapping
						if (nnon > n - 12) break;
					}
				}

				//println("no = ", no);
				if no >= 12
				{
					// Set fixed and apply rotation and translation to d. Update
					// i to j for next iteration
					fixed[j] = true;
					d[:,:,j] = tj;
					ifixed = [ifixed, [j]];
					nfixed = size(ifixed);
					nfree -= 1;
					ifree = [ifree[0:jfr], ifree[jfr+1:]];
					//println("ifixed = ", ifixed);
					//println("ifree  = ", ifree);

					pos[:,j] = t;

					ncon[i] += 1;
					ncon[j] += 1;
					//println("ncon = ", ncon);

					println("fixed count = ", count(fixed), " / ", ns);
					break;
				}
			}
			if fixed[j] break;
		}
		if fixed[j] break;
	}
	}
	if all(fixed) break;
	}

	// All beacons are set. Get their unique count
	let be = dict_i64::new();
	for is in [0: ns]
	for ib in [0: nbps[is]]
		be.set(str(d[:,ib,is]), 1'i64);
	sum_ = be.len();

	//println("pos = ", pos);
	let ip2 = 0;
	for i in [0: ns]
	for j in [i+1: ns]
		ip2 = max(ip2, sum(abs(pos[:,j] - pos[:,i])));

	println("part 1 = ", sum_);
	println("part 2 = ", ip2);
	p1 = str(sum_);
	p2 = str(ip2);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2021/19" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	both_parts(&args, &p1, &p2);

	let expect1 = "467";
	let expect2 = "12226";
	let expect1_test = "79";
	let expect2_test = "3621";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

//==============================================================================

