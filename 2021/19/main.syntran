fn get_rot_mats(): [i32; :,:,:]
{
	// Return an array of rotation matrices for all 24 ways to symmetrically
	// orient a cube
	let r = [0; 3, 3, 24];

	let eps = [-1; 3, 3]; // epsilon permutation symbol
	eps[0,1] = 2;
	eps[1,2] = 0;
	eps[2,0] = 1;
	eps[1,0] = 2;
	eps[2,1] = 0;
	eps[0,2] = 1;
	println("eps = ", eps);

	let k = 0;
	for i0 in [0: 3]
	//for i1 in [i0+1: 3]
	for i1 in [0: 3]
	{
		if (i0 == i1) continue;
		const i2 = eps[i0,i1];
		for s0 in [1, -1]
		for s1 in [1, -1]
		//for s2 in [1, -1]
		{
			r[0,i0,k] = s0;
			r[1,i1,k] = s1;
			r[2,:,k] = cross(r[0,:,k], r[1,:,k]);
			//r[:,i2,k] = cross(r[:,i0,k], r[:,i1,k]);

			//r[i0,0,k] = s0;
			//r[i1,1,k] = s1;

			////r[2,i2,k] = s2;
			////r[i2,:,k] = cross(r[i0,:,k], r[i1,:,k]);
			////r[2,:,k] = cross(r[0,:,k], r[1,:,k]);
			////r[:,2,k] = cross(r[i0,:,k], r[i1,:,k]);
			////r[i2,:,k] = cross(r[i0,:,k], r[i1,:,k]);
			//r[:,2,k] = cross(r[:,0,k], r[:,1,k]);
			////r[:,2,k] = cross(r[0,:,k], r[1,:,k]);
			////r[:,2,k] = cross(r[0,:,k], r[1,:,k]);
			////r[:,i2,k] = cross(r[:,i0,k], r[:,i1,k]);

			println("k = ", k);
			k += 1;
		}
	}
	return r;
}

fn cross(a: [i32;:], b: [i32;:]): [i32;:]
{
	let c = [0;3];
	c[0] = a[1] * b[2] - a[2] * b[1];
	c[1] = a[2] * b[0] - a[0] * b[2];
	c[2] = a[0] * b[1] - a[1] * b[0];
	return c;
}

fn get_rot_mats_bad(): [i32; :,:,:]
{
	// Return an array of rotation matrices for all 24 ways to symmetrically
	// orient a cube
	let r = [0; 3, 3, 24];

	let eps = [-1; 3, 3]; // epsilon permutation symbol
	eps[0,1] = 2;
	eps[1,2] = 0;
	eps[2,0] = 1;
	eps[1,0] = 2;
	eps[2,1] = 0;
	eps[0,2] = 1;
	println("eps = ", eps);

	let k = 0;
	for i0 in [0: 3]
	for i1 in [i0+1: 3]
	{
		const i2 = eps[i0,i1];
		for s0 in [1, -1]
		for s1 in [1, -1]
		for s2 in [1, -1]
		{
			r[0,i0,k] = s0;
			r[1,i1,k] = s1;
			r[2,i2,k] = s2;
			//println("k = ", k);
			k += 1;
		}
	}
	return r;
}

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;
	//return part1_check(args);

	let lines = readlns_(args.input_filename);
	let ns = 0;
	for line in lines
		if starts_with_(line, "---")
			ns += 1;
	println("ns = ", ns);

	let nbps = [0; ns]; // beacons per scanner (not uniform)
	let is = -1;
	for line in lines
		if starts_with_(line, "---")
			is += 1;
		else if line == ""
		{
			// no-op
		}
		else
			nbps[is] += 1;
	const nbmax = maxval(nbps);
	println("nbps  = ", nbps);
	println("nbmax = ", nbmax);

	// Relative beacon positions from report
	let d = [0; 3, nbmax, ns];
	is = -1;
	let ib =  0;
	for line in lines
		if starts_with_(line, "---")
		{
			is += 1;
			ib = 0;
		}
		else if line == ""
		{
			// no-op
		}
		else
		{
			d[:, ib, is] = parse_i32_delim(line, ",");
			ib += 1;
		}
	println("d = ", d);

	const r = get_rot_mats();
	//println("r = ", r);
	//exit(0);

	// Start with only the scanner 0 fixed
	let fixed = [false; ns];
	fixed[0] = true;
	let tried = [false; ns, ns];

	// Save all possible rotations ahead of time
	let dr = [0; 3, nbmax, ns, 24];
	//let d = [0; 3, nbmax, ns];
	for is in [0: ns]
	for ir in [0: 24]
		dr[:,:,is,ir] = r[:,:,ir] @ d[:,:,is];

	let ifree  = [1: ns];
	let nfree  = ns-1;
	let ifixed = [0];
	let nfixed = 1;

	// idk how to do this more efficiently. maybe you could get some kind of
	// fingerprint of each beacon -- find all possible tetrahedra contained in
	// the beacons of each scanner, then find scanners which share tetrahedra.
	// might still need a complete check for >= 12 beacon overlap after quick
	// tetrahedra elimination

	// *********************

	// TODO: i seem to be hitting an infinite loop. I think there's a
	// red-herring overlap where some scanners have multiple potential overlaps,
	// and if you connect the wrong pair you get stuck
	//
	// Or maybe the pairs are unique but there are multiple transformation
	// possibilities for connecting a pair
	//
	// I think I need to break up the batches of work. Run one slow program
	// which exports all possible pairs, and then another program which
	// constructs a valid complete graph from the first program's data
	//
	// On further investigation -- nope, i just had more bugs in get_rot_mats

	// *********************

	// TODO: optimize by tracking connection count. After a scanner is connected
	// to two other scanners, stop trying to connect others to it. Wasn't sure
	// how the graph is structured but i think this should be valid

	// idk if all these loops are necessary but i went crazy because there was a
	// bug in get_rot_mats
	while true
	{
	if all(fixed) break;
	// Find free scanner j which overlaps with fixed scanner i
	for ifi in [0: nfixed]
	{
	let i = ifixed[ifi];
	//if not fixed[i] continue;

	// Would it help to save an array of hash sets ahead of time? It would have
	// to be as each scanner is fixed
	let iset = dict_i64::new();
	for ki in [0: nbps[i]]
		iset.set(str(d[:,ki,i]), 1'i64);

	//for j in [0: ns]
	for jfr in [0: nfree]
	{
		let j = ifree[jfr];
		if all(fixed) break;
		//if fixed[j] continue;
		if tried[i,j] continue;
		tried[i,j] = true;
		println("i, j = ", [i, j]);

		// Try all rotations of scanner j
		for jr in [0: 24]
		{
			// Apply rotation. Might be faster if we save all rotations ahead of
			// time before nested loop
			//const dj = r[:,:,jr] @ d[:,:,j];
			const dj = dr[:,:,j,jr];

			// Try collocating beacon ii of scanner i with beacon jj of scanner
			// j and then count how many other beacons overlap. This search is
			// O(26**2), where ~26 is nbmax, as opposed to O(2000**3) of trying
			// every beacon location within its detection cube
			for ii in [0: nbps[i]]
			for jj in [0: nbps[j]]
			{
				if fixed[j] break;

				// Translation from ii to jj
				const t = -(dj[:,jj] - d[:,ii,i]);

				// Apply translation
				let tj = dj;
				for k in [0: 3]
					tj[k,:] += t[k];
				//for k in [0: nbps[j]]
				//	tj[:,k] += t;

				// Count overlaps using a hash set
				let no = 0;
				let nnon = 0;
				let n = nbps[j];
				for kj in [0: n]
				{
					if iset.contains(str(tj[:,kj]))
						no += 1;
					else
						nnon += 1;
					// Break early if too many not overlapping
					if nnon > n - 12
						break;
				}

				//println("no = ", no);
				if no >= 12
				{
					// Set fixed and apply rotation and translation to d. Update
					// i to j for next iteration
					fixed[j] = true;
					d[:,:,j] = tj;
					//i = j;
					ifixed = [ifixed, [j]];
					nfixed = size(ifixed);
					nfree -= 1;
					ifree = [ifree[0:jfr], ifree[jfr+1:]];
					println("ifixed = ", ifixed);
					println("ifree  = ", ifree);

					println("found");
					println("t = ", t);
					println("fixed count = ", count(fixed), " / ", ns);
					break;
				}
			}
			if fixed[j] break;
		}
		if fixed[j] break;
		//if fixed[j] continue;
	}
	}
	if all(fixed) break;
	}

	// All beacons are set. Get their unique count
	let be = dict_i64::new();
	for is in [0: ns]
	for ib in [0: nbps[is]]
		be.set(str(d[:,ib,is]), 1'i64);
	sum_ = be.len();

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part1_check(args: &const Args): str
{
	// Check connection possibilities as a pre-req for part 1
	let sum_ = 0'i64;

	let lines = readlns_(args.input_filename);
	let ns = 0;
	for line in lines
		if starts_with_(line, "---")
			ns += 1;
	println("ns = ", ns);

	let nbps = [0; ns]; // beacons per scanner (not uniform)
	let is = -1;
	for line in lines
		if starts_with_(line, "---")
			is += 1;
		else if line == ""
		{
			// no-op
		}
		else
			nbps[is] += 1;
	const nbmax = maxval(nbps);
	println("nbps  = ", nbps);
	println("nbmax = ", nbmax);

	// Relative beacon positions from report
	let d = [0; 3, nbmax, ns];
	is = -1;
	let ib =  0;
	for line in lines
		if starts_with_(line, "---")
		{
			is += 1;
			ib = 0;
		}
		else if line == ""
		{
			// no-op
		}
		else
		{
			d[:, ib, is] = parse_i32_delim(line, ",");
			ib += 1;
		}
	//println("d = ", d);
	const r = get_rot_mats();
	println("r = ", r);
	//exit(0);

	// Save all possible rotations ahead of time
	let dr = [0; 3, nbmax, ns, 24];
	for is in [0: ns]
	for ir in [0: 24]
		dr[:,:,is,ir] = r[:,:,ir] @ d[:,:,is];

	let ncon = 0;

	for i in [0: ns]
	{
	let iset = dict_i64::new();
	for ki in [0: nbps[i]]
		iset.set(str(d[:,ki,i]), 1'i64);

	for j in [0: ns]
	{
		if (i == j) continue;
		println();
		println("i, j = ", [i, j]);

		let tset = dict_i64::new();  // set of valid overlapping transformations

		// Try all rotations of scanner j
		for jr in [0: 24]
		{
			// Apply rotation
			const dj = dr[:,:,j,jr];

			// Try collocating beacon ii of scanner i with beacon jj of scanner
			// j and then count how many other beacons overlap. This search is
			// O(26**2), where ~26 is nbmax, as opposed to O(2000**3) of trying
			// every beacon location within its detection cube
			for ii in [0: nbps[i]]
			for jj in [0: nbps[j]]
			{
				// Translation from ii to jj
				const t = -(dj[:,jj] - d[:,ii,i]);
				const tkey = str(t, jr);
				if tset.contains(tkey) continue;

				// Apply translation
				let tj = dj;
				//for k in [0: 3]
				//	tj[k,:] += t[k];
				for k in [0: nbps[j]]
					tj[:,k] += t;

				// Count overlaps using a hash set
				let no = 0;
				let nnon = 0;
				let n = nbps[j];
				for kj in [0: n]
				{
					if iset.contains(str(tj[:,kj]))
						no += 1;
					else
						nnon += 1;
					//// Break early if too many not overlapping
					//if nnon > n - 12
					//	break;
				}

				//println("no = ", no);
				if no >= 12
				{
					ncon += 1;
					println("found");
					//println("t = ", t);
					println("tkey = ", tkey);
					tset.set(tkey, 1'i64);
					//break;
				}
			}
		}
	}
	}
	println("ncon = ", ncon);

	// All beacons are set. Get their unique count
	let be = dict_i64::new();
	for is in [0: ns]
	for ib in [0: nbps[is]]
		be.set(str(d[:,ib,is]), 1'i64);
	sum_ = be.len();

	println("part check = ", sum_);
	return str(sum_);
}

