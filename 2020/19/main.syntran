
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;
use ../../dict_str_2026 as dict_str;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let lines = readlns_(args.input_filename);
	let iblank = 0;
	for line in lines
		if line == ""
			break;
		else
			iblank += 1;
	//println("iblank = ", iblank);
	let rules_str = lines[0: iblank];
	let msgs = lines[iblank+1:];
	println("rules_str = ", rules_str);
	println("msgs = ", msgs);

	// Rules could fairly easily be put in an array instead of dict. Do we need
	// the perf?
	let rules = dict_str::new();
	for rule_str in rules_str
	{
		let words = split_(rule_str, ":");
		let key = words[0];
		let val = words[1];
		rules.set(key, val);
	}
	//rules.print("rules = ");

	let pattern = rules.get("0");
	//println("pattern = ", pattern);

	for msg in msgs
	{
		let match = is_match(&rules, pattern, &msg);
		//println("******************");
		//println("match = ", match);

		// idk how to build this into the recursion. check empty str here to
		// make sure we consumed the entire input, i.e. not just matching a
		// partial prefix
		if match and msg == ""
			sum_ += 1;
	}

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	let lines = readlns_(args.input_filename);
	let iblank = 0;
	for line in lines
		if line == ""
			break;
		else
			iblank += 1;
	//println("iblank = ", iblank);
	let rules_str = lines[0: iblank];
	let msgs = lines[iblank+1:];
	println("rules_str = ", rules_str);
	println("msgs = ", msgs);
	println();

	// Rules could fairly easily be put in an array instead of dict. Do we need
	// the perf?
	let rules = dict_str::new();
	for rule_str in rules_str
	{
		let words = split_(rule_str, ":");
		let key = words[0];
		let val = words[1];
		rules.set(key, val);
	}
	//rules.print("rules = ");

	// Overwrite rules 8 and 11 for part 2:
	//
	//     8: 42 | 42 8
	//     11: 42 31 | 42 11 31

	//rules.set( "8", "42 | 42 8");
	//rules.set("11", "42 31 | 42 11 31");
	////rules.set( "8", "42 8 | 42"); // reversing the pipe yields 0 matches??
	////rules.set("11", "42 11 31 | 42 31");

	let pattern = rules.get("0");
	//println("pattern = ", pattern);

	let rule42 = rules.get("42");
	let rule31 = rules.get("31");
	println("rule42 = ", rule42);
	println("rule31 = ", rule31);
	if rule42 == ""
	{
		println(ERROR_STR + "can't run part 2 on test-input.txt");
		exit(1);
	}

	// We are given:
	//     0: 8 11
	//     8: 42 | 42 8
	//     11: 42 31 | 42 11 31
	//
	// Therefore:
	//     0: (42 | 42 8) (42 31 | 42 11 31)
	//
	// In other words:
	//     0: (42 | 42 (42 | (42 | ...))) (42 (42 (42 (...) 31) 31) 31)
	//     0: 42a\+ 42b\+ 31b\+
	//
	// So the matching strings must match 42 any non-zero number of times
	// (42a\+), followed again by 42 any number of times (42b\+) followed
	// finally by 31 the *same* number of times as 42b
	//
	// I had to cheat today. I looked a lot at this python solution:
	//
	//     https://github.com/Gprinziv/Advent2020/blob/master/Day%2019/messages.py
	//
	// Mine ended up being fairly different because I wanted to leverage my
	// is_match() fn from part 1 and it looked like to much work to exactly port
	// the python author's getLen() and getRule() fns which weren't anything
	// like what I had for part 1

	for msg in msgs
	{
		//println();
		//println("-----------");
		//println("msg = ", msg);
		let msg0 = msg;
		let match = true;
		let match42 = false;
		let match31 = false;
		let n42 = 0;
		let n31 = 0;
		while true
		{
			if (msg == "") break;
			match = is_match(&rules, rule42, &msg);
			if (not match) break;
			match42 = true;
			n42 += 1;
			//println("42 ", msg);
		}
		while true
		{
			if (msg == "") break;
			match = is_match(&rules, rule31, &msg);
			if (not match) break;
			match31 = true;
			n31 += 1;
			//println("31 ", msg);
		}

		//let msg0 = msg;
		//let match = is_valid(&rules, pattern, &msg);
		////println("******************");
		////println("match = ", match);

		if match and match42 and match31 and msg == "" and n42 > n31
		{
			//println("match: ", msg0);
			//println("n42|31 = ", [n42, n31]);
			sum_ += 1;
		}
		//else
		//{
		//	println("NOT match");
		//}
	}

	// Tried 211 -- too low
	// Tried 386 -- too high
	println("part 2 = ", sum_);
	return str(sum_);
}

fn is_match(rules: &dict_str::dict_str, pattern: str, msg: &str): bool
{
	// If the msg matches the pattern, trim (consume) the matched prefix off the
	// front of the msg and return true

	//println();
	//println("pattern = ", pattern);
	//println("msg     = ", msg);

	// Base cases: just "a" or "b"
	if pattern == r#" "a""#
		if msg[0] == "a"
		{
			msg = msg[1:];  // trim prefix
			return true;
		}
		else return false;
	if pattern == r#" "b""#
		if msg[0] == "b"
		{
			msg = msg[1:];
			return true;
		}
		else return false;

	if index_(pattern, "|") >= 0
	{
		// Pipe "or" branch. There's never more than 1 pipe per rule
		let words = split_(pattern, "|");
		let left  = words[0];
		let right = words[1];
		//println("left  = ", left);
		//println("right = ", right);

		let match = is_match(&rules, left, &msg);
		if match
			return true;
		match = is_match(&rules, right, &msg);
		if match
			return true;
		return false;
	}

	// No pipe and no primitive a/b, just a string of other rules
	let keys = split_(pattern, " ");
	//println("keys = ", keys);
	let msg0 = msg;
	for key in keys
	{
		let match = is_match(&rules, rules.get(key), &msg);
		//println("match = ", match);
		if (not match)
		{
			msg = msg0;  // reset msg after failed partial match
			return false;
		}
	}
	//println("END KEYS ITER");
	//println("msg = """, msg, """");
	return true;
}

fn is_valid(rules: &dict_str::dict_str, pattern: str, msg: &str): bool
{
	// Wrapper for is_match() which also ensures the whole msg is matched, not
	// just a partial prefix
	let match = is_match(&rules, pattern, &msg);
	return match and msg == "";
}

