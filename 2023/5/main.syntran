// Use this to break early and debug part 2
let MAP_DBG = "";
//MAP_DBG = "soil-to-fertilizer map:";
//MAP_DBG = "fertilizer-to-water map:";
//MAP_DBG = "water-to-light map:";
//MAP_DBG = "light-to-temperature map:";
//MAP_DBG = "temperature-to-humidity map:";
//MAP_DBG = "humidity-to-location map:";

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const lines = readlns_(args.input_filename);
	const nline = size(lines);
	//println("lines = ", NEWLINE_ + lines);

	const seeds = parse_i64_delim(lines[0], "seeds: ");
	let v = seeds;
	let n = size(seeds);
	//println("seeds = ", seeds);

	let iline = 2;
	while true
	{
		const v0 = v;
		//println("map name = " + lines[iline]);

		if (lines[iline] == MAP_DBG) break;

		while true
		{
			iline += 1;
			if (iline >= nline) break;
			if (lines[iline] == "") break;
			const map = parse_i64_delim(lines[iline], " ");
			//println("map = ", map);
			const dst = map[0];
			const src = map[1];
			const len = map[2];
			const end = src + len ;//+ 1;
			const del = dst - src;
			for i in [0: n]
				if src <= v0[i] and v0[i] < end
					v[i] = v0[i] + del;
			//println("    v = ", v);
			//println();
		}
		//sort_inplace_i64(&v);  // just for debugging part 2
		//println("v = ", v);
		iline += 1;
		if (iline >= nline) break;
	}
	//sort_inplace_i64(&v);  // just for debugging part 2
	//println("v = ", v);
	sum_ = minval(v);

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	const lines = readlns_(args.input_filename);
	const nline = size(lines);

	const seeds = parse_i64_delim(lines[0], "seeds: ");
	//println("seeds = ", seeds);
	let r = std::reshape(seeds, [2, i32(size(seeds))/2]);
	let n = size(r,1);
	//println("r = ", r);

	// Represent ranges as [start, end) instead of [start, len]
	for i in [0: n]
		r[1,i] = r[0,i] + r[1,i];
	//println("r = ", r);

	let iline = 2;
	while true
	{
		if (lines[iline] == MAP_DBG) break;

		// Preload all rows for this entire map
		const il0 = iline;
		let nmap = 0;
		while true
		{
			// Count
			iline += 1;
			if (iline >= nline) break;
			if (lines[iline] == "") break;
			nmap += 1;
		}
		iline = il0;
		let maps = [-1'i64; 3, nmap];
		nmap = 0;
		while true
		{
			// Load
			iline += 1;
			if (iline >= nline) break;
			if (lines[iline] == "") break;
			const map = parse_i64_delim(lines[iline], " ");
			maps[:,nmap] = map;
			nmap += 1;
		}
		//println("maps = ", maps);

		let nr0 = size(r, 1);
		let r0 = [-1'i64; 2, nr0*2];
		r0[:, :nr0] = r;

		let nr = 0;
		const cap = nr0 * 3 + 4;  // pre-allocate at a conservative size
		r = [-1; 2, cap];
		//println("r0 = ", r0);

		let i = -1;
		while i < nr0
		{
			i += 1;
			// Iterate through input ranges in outer loop and map rows in inner
			// loop to avoid tracking what has been shifted or swapping r to r0
			// multiple times per map
			for im in [0: nmap]
			{
				const dst = maps[0, im];
				const src = maps[1, im];
				const len = maps[2, im];
				const end = src + len ;//+ 1;
				const del = dst - src;
				//println("src, end = ", [src, end]);
				if r0[1,i] < src or r0[0,i] > end
				{
					// disjoint. no-op
				}
				else if src <= r0[0,i] and r0[1,i] <= end
				{
					// contained entirely. apply uniform shift on whole range
					//println("contained");
					r[:,nr] = r0[:,i] + del;
					nr += 1;
					r0[:,i] = [-1, -1];
				}
				else if r0[0,i] < src and end < r0[1,i]
				{
					// enveloping
					let tmp = r0[1,i];
					r0[:,i] = [r0[0,i], src]; // lower identity part: replace in r0

					r[:,nr] = [src+del, end+del]; // shifted part
					nr += 1;

					r0[:,nr0] = [end, tmp];  // upper identity part: push to r0
					nr0 += 1;
				}
				else if r0[0,i] < src
				{
					// input straddles lower-end of map
					//println("lower");
					r[:,nr] = [src + del, r0[1,i] + del];  // shifted part
					nr += 1;

					r0[:,i] = [r0[0,i], src];  // identity part
				}
				else if r0[1,i] > end
				{
					// input straddles upper-end of map
					//println("upper");
					r[:,nr] = [r0[0,i] + del, end + del];  // shifted part
					nr += 1;

					r0[:,i] = [end, r0[1,i]];  // identity part
				}
				else
				{
					println(ERROR_STR + "unhandled unknown case");
					exit(2);
				}
			}
			if r0[0,i] < r0[1,i]
			{
				// Disjoint parts deferred from loop above
				r[:,nr] = r0[:,i];
				nr += 1;
			}
		}

		// Don't bother merging overlapping ranges. Perf isn't that critical,
		// this runs in 0.1 s anyway
		r = r[:, 0:nr];  // trim
		//println("r = ", r);

		iline += 1;
		if (iline >= nline) break;
	}
	//println("final r = ", r);
	sum_ = minval(r[0,:]);

	// Tried 47198068 -- too high
	// Tried 20244680 -- too low
	println("part 2 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2023/5" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "261668924";
	let expect2 = "24261545";
	let expect1_test = "35";
	let expect2_test = "46";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

