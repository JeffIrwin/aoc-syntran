
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;
use ../../stack_vec_i64 as stack_vec_i64;

// c.f. my original part-1-only solution in dir "05" (as opposed to "5")

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const lines = readlns_(args.input_filename);
	const nline = size(lines);
	//println("lines = ", NEWLINE_ + lines);

	const seeds = parse_i64_delim(lines[0], "seeds: ");
	let v = seeds;
	let n = size(seeds);
	//println("seeds = ", seeds);

	let iline = 2;
	while true
	{
		const v0 = v;
		//println("map name = " + lines[iline]);

		while true
		{
			iline += 1;
			if (iline >= nline) break;
			if (lines[iline] == "") break;
			const map = parse_i64_delim(lines[iline], " ");
			//println("map = ", map);
			const dst = map[0];
			const src = map[1];
			const len = map[2];
			const end = src + len ;//+ 1;
			const del = dst - src;
			for i in [0: n]
				if src <= v0[i] and v0[i] < end
					v[i] = v0[i] + del;
			//println("    v = ", v);
			//println();
		}
		//sort_inplace_i64(&v);  // just for debugging part 2
		//println("v = ", v);
		iline += 1;
		if (iline >= nline) break;
	}
	//sort_inplace_i64(&v);  // just for debugging part 2
	//println("v = ", v);
	sum_ = minval(v);

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	const lines = readlns_(args.input_filename);
	const nline = size(lines);

	const seeds = parse_i64_delim(lines[0], "seeds: ");
	//println("seeds = ", seeds);
	let rarray = std::reshape(seeds, [2, i32(size(seeds))/2]);
	const n = size(rarray,1);
	//println("rarray = ", rarray);

	// Represent ranges as [start, end) instead of [start, len]
	let r = stack_vec_i64::new();
	for i in [0: n]
	{
		rarray[1,i] = rarray[0,i] + rarray[1,i];
		r.push(rarray[:,i]);
	}
	//println("r = ", r.vals);

	let iline = 2;
	while true
	{
		// Preload all rows for this entire map
		const il0 = iline;
		let nmap = 0;
		while true
		{
			// Count
			iline += 1;
			if (iline >= nline) break;
			if (lines[iline] == "") break;
			nmap += 1;
		}
		iline = il0;
		let maps = [-1'i64; 3, nmap];
		nmap = 0;
		while true
		{
			// Load
			iline += 1;
			if (iline >= nline) break;
			if (lines[iline] == "") break;
			const map = parse_i64_delim(lines[iline], " ");
			maps[:,nmap] = map;
			nmap += 1;
		}
		//println("maps = ", maps);
		//println("r = ", r);

		let r0s = r;
		r = stack_vec_i64::new();
		while not r0s.is_empty()
		{
			let r0 = r0s.pop();  // a single range from the stack of ranges
			//println("r0 = ", r0);

			// Iterate through input ranges in outer loop and map rows in inner
			// loop to avoid tracking what has been shifted or swapping r to r0
			// multiple times per map
			for im in [0: nmap]
			{
				const dst = maps[0, im];
				const src = maps[1, im];
				const len = maps[2, im];
				const end = src + len ;
				const del = dst - src;
				//println("src, end = ", [src, end]);

				const overlap_min = max(r0[0], src);
				const overlap_max = min(r0[1], end);
				//println("overlap = ", [overlap_min, overlap_max]);
				if overlap_min < overlap_max
				{
					//println("overlap");
					r.push([overlap_min, overlap_max] + del);
					if r0[0] < overlap_min
						r0s.push([r0[0], overlap_min]);
					if overlap_max < r0[1]
						r0s.push([overlap_max, r0[1]]);
					r0 = [-1, -1];
					break;
				}
			}
			if r0[0] < r0[1]
			{
				// Disjoint parts deferred from loop above
				r.push(r0);
			}
		}

		// Don't bother merging overlapping ranges. Perf isn't that critical,
		// this runs in 0.1 s anyway

		iline += 1;
		if (iline >= nline) break;
	}
	//println("final r = ", r);
	sum_ = minval(r.vals[0,:r.len]);

	// Tried 47198068 -- too high
	// Tried 20244680 -- too low
	println("part 2 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2023/5" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "261668924";
	let expect2 = "24261545";
	let expect1_test = "35";
	let expect2_test = "46";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

