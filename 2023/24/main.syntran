//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const data = read_i64_mat_delim(args.input_filename, ",@ ");
	println("data = ", data);

	let xmin = 200_000_000_000_000;
	let xmax = 400_000_000_000_000;
	let ymin = 200_000_000_000_000;
	let ymax = 400_000_000_000_000;
	if args.input_filename == "test-input.txt"
	{
		xmin = 7;
		xmax = 27;
		ymin = 7;
		ymax = 27;
	}

	const n = size(data,1);
	for j in [0: n]
	for i in [0: j]
	{
		println("i, j = ", [i, j]);

		const pix = data[0, i];
		const piy = data[1, i];
		const vix = data[3, i];
		const viy = data[4, i];
		const pjx = data[0, j];
		const pjy = data[1, j];
		const vjx = data[3, j];
		const vjy = data[4, j];
	}

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	const data = read_i64_mat_delim(args.input_filename, ",@ ");
	const n = size(data,1);

	// Loop through hailstone triplets [i0, i1, i2]
	for i2 in [0: n]
	for i1 in [0: i2]
	for i0 in [0: i1]
	{
		const p0 = 1.0 * data[0:3, i0];  // known positions/velocities
		const p1 = 1.0 * data[0:3, i1];
		const p2 = 1.0 * data[0:3, i2];
		const v0 = 1.0 * data[3:6, i0];
		const v1 = 1.0 * data[3:6, i1];
		const v2 = 1.0 * data[3:6, i2];

		// Out-args for the pos/vel which we're solving for
		let p = [0.0; 3];
		let v = [0.0; 3];

		const io = solve2(p0, p1, p2, v0, v1, v2, &p, &v);
		if (io != 0) continue;

		//println("p = ", p);
		const ip = i64(p);
		//println("ip = ", ip);
		const fsum = sum(p);
		sum_ = i64(fsum);
		//println("fsum = ", fsum);

		// Poor man's nearest integer
		if (sum_ - fsum < 0.4) sum_ += 1;
		if (sum_ - fsum > 0.4) sum_ -= 1;

		println("part 2 = ", sum_);
		return str(sum_);
	}
	return "";
}

// Global hailstone parameters. See note in get_rhs() below
let qx0_glbl = 0.0;
let qy0_glbl = 0.0;
let qz0_glbl = 0.0;
let qx1_glbl = 0.0;
let qy1_glbl = 0.0;
let qz1_glbl = 0.0;
let qx2_glbl = 0.0;
let qy2_glbl = 0.0;
let qz2_glbl = 0.0;
let wx0_glbl = 0.0;
let wy0_glbl = 0.0;
let wz0_glbl = 0.0;
let wx1_glbl = 0.0;
let wy1_glbl = 0.0;
let wz1_glbl = 0.0;
let wx2_glbl = 0.0;
let wy2_glbl = 0.0;
let wz2_glbl = 0.0;

fn get_rhs(x: [f64; :]): [f64; :]
{
	// Return the residual for our non-linear root-finding problem
	//
	// Unknown ordering convention:
	//
	// - px, py, pz, vx, vy, vz, t0, t1, t2
	//
	// My Newton-Raphson implemention cannot take other parameters besides the
	// "solution" vector `x`, so w*_glbl and q*_glbl terms are passed in via
	// global variables. These are constant for a given triplet of hailstones
	// which we're trying to intersect (and of course variable if your trying
	// several different candidate triplets)
	//
	// For an example of how to solve problems like this without global vars,
	// see this call which uses a "params" fn signature instead:
	//
	//     https://github.com/JeffIrwin/numerical-analysis/blob/5218aa8439405dd39fd9e1e2f7e3846850558a51/test/chapter_3.f90#L527
	//
	const px = x[0];
	const py = x[1];
	const pz = x[2];
	const vx = x[3];
	const vy = x[4];
	const vz = x[5];
	const t0 = x[6];
	const t1 = x[7];
	const t2 = x[8];
	return [
		px + t0*vx - qx0_glbl - t0*wx0_glbl,
		py + t0*vy - qy0_glbl - t0*wy0_glbl,
		pz + t0*vz - qz0_glbl - t0*wz0_glbl,
		px + t1*vx - qx1_glbl - t1*wx1_glbl,
		py + t1*vy - qy1_glbl - t1*wy1_glbl,
		pz + t1*vz - qz1_glbl - t1*wz1_glbl,
		px + t2*vx - qx2_glbl - t2*wx2_glbl,
		py + t2*vy - qy2_glbl - t2*wy2_glbl,
		pz + t2*vz - qz2_glbl - t2*wz2_glbl,
	];
}

fn get_stiffness(x: [f64; :]): [f64; :,:]
{
	// Return the derivative of the residual wrt to the `x` parameters, i.e. the
	// stiffness matrix
	//
	// See math.md for the derivation of the residual RHS and stiffness matrix
	//
	const vx = x[3];
	const vy = x[4];
	const vz = x[5];
	const t0 = x[6];
	const t1 = x[7];
	const t2 = x[8];
	return std::transpose([
		1., 0., 0.,   t0,  0., 0.,     vx-wx0_glbl,      0.,      0.,
		0., 1., 0.,   0. , t0, 0.,     vy-wy0_glbl,      0.,      0.,
		0., 0., 1.,   0. , 0., t0,     vz-wz0_glbl,      0.,      0.,

		1., 0., 0.,   t1,  0., 0.,          0., vx-wx1_glbl,      0.,
		0., 1., 0.,    0., t1, 0.,          0., vy-wy1_glbl,      0.,
		0., 0., 1.,    0., 0., t1,          0., vz-wz1_glbl,      0.,

		1., 0., 0.,   t2,  0., 0.,          0.,      0., vx-wx2_glbl,
		0., 1., 0.,    0., t2, 0.,          0.,      0., vy-wy2_glbl,
		0., 0., 1.,    0., 0., t2,          0.,      0., vz-wz2_glbl,
		;
		9, 9
	]);
}

fn solve2(
	q0: [f64; :], q1: [f64; :], q2: [f64; :],
	w0: [f64; :], w1: [f64; :], w2: [f64; :],
	p: &[f64; :],
	v: &[f64; :],
): i32
{
	// Find position `p` and velocity `v` in order to intersect with 3
	// hailstones with positions q* and velocities w*. Return code 0 if a
	// solution exists
	//
	// Equation ordering convention:
	//
	// px + t0*vx - qx0 - t0*wx0 = 0
	// py + t0*vy - qy0 - t0*wy0 = 0
	// pz + t0*vz - qz0 - t0*wz0 = 0
	//
	// px + t1*vx - qx1 - t1*wx1 = 0
	// py + t1*vy - qy1 - t1*wy1 = 0
	// pz + t1*vz - qz1 - t1*wz1 = 0
	//
	// px + t2*vx - qx2 - t2*wx2 = 0
	// py + t2*vy - qy2 - t2*wy2 = 0
	// pz + t2*vz - qz2 - t2*wz2 = 0
	qx0_glbl = q0[0];
	qy0_glbl = q0[1];
	qz0_glbl = q0[2];
	qx1_glbl = q1[0];
	qy1_glbl = q1[1];
	qz1_glbl = q1[2];
	qx2_glbl = q2[0];
	qy2_glbl = q2[1];
	qz2_glbl = q2[2];

	wx0_glbl = w0[0];
	wy0_glbl = w0[1];
	wz0_glbl = w0[2];
	wx1_glbl = w1[0];
	wy1_glbl = w1[1];
	wz1_glbl = w1[2];
	wx2_glbl = w2[0];
	wy2_glbl = w2[1];
	wz2_glbl = w2[2];

	// Oddly, starting with a uniform initial guess diverges. So we use [1, 2,
	// 3, ...]
	const sln = numa::newton_raphson_nd(get_rhs, get_stiffness, 1.0*[1:10]);
	const rhs_vrf = get_rhs(sln);

	// This tolerance, or even the tol/iter settings currently hard-coded inside
	// of newton_raphson_nd(), may need to be adjusted for other inputs
	const tol = 1.e-9;
	if norm2(rhs_vrf) > tol
	{
		// This is expected in same degenerate cases, e.g. parallel velocities
		//
		// The real solver will have to try multiple triplets until a
		// well-behaved combination is found

		//println(WARN_STR + "bad solution");
		return 1;
	}
	if any(sln != sln)
	{
		// Lazy NaN check
		return 2;
	}

	// Valid solution
	p = sln[0:3];
	v = sln[3:6];
	return 0;
}

