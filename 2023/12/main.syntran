
use ../../utils::*;
use ../../dict_i64_2026 as dict_i64;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	let iline = 0'i64;
	while not eof(f)
	{
		iline += 1;
		println("str_ = ", str_);

		const words = split_(str_, " ");
		const pattern = words[0];
		const groups = parse_i32_delim(words[1], ",");
		println("pattern = ", pattern);
		println("groups  = ", groups);

		const narr = count_arr1(pattern, groups);
		sum_ += narr;
		println("line, count = ", [iline, narr]);

		println();
		str_ = readln(f);
	}
	close(f);

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	let iline = 0'i64;
	while not eof(f)
	{
		iline += 1;
		println("str_ = ", str_);

		const words = split_(str_, " ");

		let pattern = repeat(words[0] + "?", 5);
		pattern = pattern[0: len(pattern)-1];
		const groups = parse_i32_delim(repeat(words[1] + ",", 5), ",");

		println("pattern = ", pattern);
		println("groups  = ", groups);

		const narr = count_arr1(pattern, groups);
		sum_ += narr;
		println("line, count = ", [iline, narr]);
		//if (iline == 8) break;
		//break;

		println();
		str_ = readln(f);
	}
	close(f);

	println("part 2 = ", sum_);
	return str(sum_);
}

let cache = dict_i64::new();
fn count_arr1(pattern: str, groups: [i32; :]): i64
{
	//// We can just keep building up the same cache across all lines
	//cache = dict_i64::new();  // reset on each input line?

	return dfs1(pattern, groups);
}

fn dfs1(pattern: str, groups: [i32; :]): i64
{
	const key = str(pattern, groups);
	const ans = cache.get(key);
	if ans >= 0
		return ans;

	let cnt = 0'i64;
	//println();
	//println("pattern = ", pattern);
	const ih0 = scan(pattern, "#");
	let iq0 = scan(pattern, "?");
	//println("ih0, iq0 = ", [ih0, iq0]);

	let ng = -1;
	if ih0 < iq0 or iq0 < 0
	{
		// TODO: count_groups only needs to count the first group now that we're
		// chopping. Might as well inline. Array logic below could be simplified
		//
		// I tried for a bit but haven't gotten it right

		const g = count_groups(pattern);
		//println("g = ", g);
		ng = size(g);

		if ng > size(groups)
		{
			cache.set(key, 0'i64);
			return 0'i64;
		}
		if any(g != groups[:ng])
		{
			cache.set(key, 0'i64);
			return 0'i64;
		}
		if ng == size(groups) and iq0 < 0
			if all(g == groups)
			{
				cache.set(key, 1'i64);
				return 1'i64;
			}
		if iq0 < 0
		{
			cache.set(key, 0'i64);
			return 0'i64;
		}

		// Chop off matched prefix
		let idl = iq0;
		while true
		{
			if (idl < 0) break;
			if (pattern[idl] == ".") break;
			idl -= 1;
		}
		//println("idl, ng = ", idl, ", ", ng);
		pattern = pattern[idl+1:];
		groups = groups[ng:];
		iq0 = scan(pattern, "?");
	}

	pattern[iq0] = ".";
	const iqn = scan(pattern, "?");
	cnt += dfs1(pattern, groups);

	pattern[iq0] = "#";
	cnt += dfs1(pattern, groups);
	
	cache.set(key, cnt);
	return cnt;
}

fn count_groups(s: &const str): [i32; :]
{
	const ns = len(s);
	let g = [0; ns/2 + 1];
	let ng = 0;

	let i = 0;
	while true
	{
		while true
		{
			if (i == ns) break;
			if (s[i] != ".") break;
			i += 1;
		}
		if (i == ns) break;

		const i0 = i;

		while true
		{
			if (i == ns) break;
			if (s[i] != "#") break;
			i += 1;
		}

		if i<ns
			if s[i] == "?"
				return g[0: ng];
		g[ng] = i - i0;
		ng += 1;

		if (i >= ns) break;
	}
	return g[0: ng];
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2023/12" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "7307";
	let expect2 = "3415570893842";
	let expect1_test = "21";
	let expect2_test = "525152";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

