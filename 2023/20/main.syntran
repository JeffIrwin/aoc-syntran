
use ../../utils::*;
use ../../dict_i64_2026 as dict_i64;
use ../../dict_str_2026 as dict_str;
use ../../queue_vec_i32 as queue_vec_i32;

//==============================================================================

// Module types
const MODULE_FLIP = 1;  // flip-flop
const MODULE_CONJ = 2;  // conjunction
const MODULE_BRDC = 3;  // broadcaster

// Pulse types
const PULSE_LO = 10;
const PULSE_HI = 20;

// Flip-flop state types
const FLIP_OFF = 100;
const FLIP_ON  = 200;

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	let ids = dict_i64::new();
	let outputs_str = dict_str::new();
	const n = countln_(args.input_filename);

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	let id = 0;
	let names = [""; n];
	let types = [-1; n];
	let max_outputs = 0;
	while not eof(f)
	{
		//println("str_ = ", str_);

		let words = split_(str_, "->, ");
		let src  = words[0];
		let dsts = cat_strs(words[1:] + ",");
		max_outputs = max(max_outputs, i32(size(words)) - 1);
		if src[0] == "%"
		{
			types[id] = MODULE_FLIP;
			names[id] = src[1:];
		}
		else if src[0] == "&"
		{
			types[id] = MODULE_CONJ;
			names[id] = src[1:];
		}
		else
		{
			types[id] = MODULE_BRDC;
			names[id] = src;
		}
		outputs_str.set(names[id], dsts);
		ids.set(names[id], i64(id));
		id += 1;

		//println("src  = ", src);
		//println("dsts = ", dsts);
		//println();

		str_ = readln(f);
	}
	close(f);
	//outputs_str.print("outputs_str = ");
	//ids.print("ids = ");
	//println("names = ", names);
	//println("types = ", types);

	// Convert graph from str dict to array
	let outputs  = [-1; max_outputs, n];
	let noutputs = [0; n];
	let ninputs  = [0; n];
	for i in [0: n]
	{
		let dsts = split_(outputs_str.get(names[i]), ",");
		noutputs[i] = size(dsts);
		for j in [0: noutputs[i]]
		{
			const id = ids.get(dsts[j]);
			if (id < 0) continue;
			outputs[j,i] = id;
			ninputs[id] += 1;
		}
	}
	const max_inputs = maxval(ninputs);
	let inputs = [-1; max_inputs, n];
	ninputs = 0;  // reset
	for i in [0: n]
	{
		for j in [0: noutputs[i]]
		{
			const out = outputs[j,i];
			if (out < 0) continue;
			inputs[ninputs[out], out] = i;
			ninputs[out] += 1;
		}
	}
	//println("outputs = ", outputs);
	//println("inputs  = ", inputs);
	//println("noutputs = ", noutputs);
	//println("ninputs  = ", ninputs);
	//println("max_outputs = ", max_outputs);
	//println("max_inputs  = ", max_inputs);
	//println();

	// Initialize state for flip-flops and conjunctions. Arrays are larger than
	// they need to be but nbd
	let fstate = [FLIP_OFF; n];
	let cstate = [PULSE_LO; max_inputs, n];

	let nhi = 0;
	let nlo = 0;
	for ibutton in [0: 1000]
	{
		// Queue of pulse type, destination module ID, and source ID
		let q = queue_vec_i32::new();

		// Pressing the button sends a low pulse to the broadcaster
		//println("button");
		q.push([PULSE_LO, i32(ids.get("broadcaster")), -1]);
		//println("q = ", q);
		while not q.is_empty()
		{
			const u = q.pop();
			//println("u = ", u);
			const pulse  = u[0];
			const module = u[1];
			const src    = u[2];

			if pulse == PULSE_LO
				nlo += 1;
			else
				nhi += 1;

			if (module < 0) continue;

			let src_name = "button";
			let pls_name = "-low->";
			if (src >= 0) src_name = names[src];
			if (pulse == PULSE_HI) pls_name = "-high->";
			////println("pulse ", pulse, " to ", names[module]);
			//println(src_name + " " + pls_name + " " + names[module]);

			switch types[module] {
			case MODULE_BRDC
			{
				// The broadcaster sends the same pulse to all its destinations
				for dst in outputs[0: noutputs[module], module]
					q.push([pulse, dst, module]);
			}
			case MODULE_FLIP
			{
				// Nothing happens for high pulse

				if pulse == PULSE_LO
				{
					// If it was off, it turns on and sends a high pulse. If it
					// was on, it turns off and sends a low pulse
					let pout = -1;
					if fstate[module] == FLIP_OFF
					{
						fstate[module] = FLIP_ON;
						pout = PULSE_HI;
					}
					else
					{
						fstate[module] = FLIP_OFF;
						pout = PULSE_LO;
					}
					// TODO: dry this loop between all three module type branches?
					for dst in outputs[0: noutputs[module], module]
						q.push([pout, dst, module]);
				}
			}
			case MODULE_CONJ
			{
				// When a pulse is received, the conjunction module first
				// updates its memory for that input. Then, if it remembers high
				// pulses for all inputs, it sends a low pulse; otherwise, it
				// sends a high pulse.

				//let val = 0;
				//for k in [0: ninputs[module]]
				//	if cstate[k, module] == PULSE_HI
				//		val |= 1 << k;
				//println(names[module], " = ", val);

				//println("inputs = ", inputs[:, module]);

				// Linear scan for index `j` of src in module's inputs
				let j = 0;
				while (inputs[j, module] != src) j += 1;
				//println("j = ", j);

				// Update memory
				cstate[j, module] = pulse;

				// Send pulse
				let pout = PULSE_HI;
				if all(cstate[0: ninputs[module], module] == PULSE_HI)
					pout = PULSE_LO;
				for dst in outputs[0: noutputs[module], module]
					q.push([pout, dst, module]);
			}}
		}
		//println();
	}
	sum_ = nlo * nhi;

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	// I had to cheat for part 2 today, but it feels like a relatively small
	// cheat compared to copying someone's python code like I sometimes resort
	// to
	//
	// It clicked for me after I just read this comment from @exquisitus3 on
	// reddit:
	//
	//   > [Language: Lua and Dot] I solved this in Lua, but for part two I used
	//   > the following script (depends on tr, sed and graphviz) to generate an
	//   > SVG file and thus visualise the configuration of the modules. This
	//   > shows clearly that module rx only has one input, a conjunction of
	//   > four other inputs, each of which comes from a separate component of
	//   > the directed graph. Since the flip-flops of each of the four
	//   > components do not interfere with one another, it suffices to count
	//   > when each component will be all zero. Those four counts turned out to
	//   > be all prime, so that their Least Common Multiple was their product.
	//   > I have redacted the Lua code link partially, since for part two it
	//   > depends on the visual inspection of the SVG file for my input.

	let sum_ = 0'i64;

	let ids = dict_i64::new();
	let outputs_str = dict_str::new();
	const n = countln_(args.input_filename);

	let f = open(args.input_filename, "r");
	let str_ = readln(f);
	let id = 0;
	let names = [""; n];
	let types = [-1; n];
	let max_outputs = 0;
	let rx_in = -1;
	while not eof(f)
	{
		let words = split_(str_, "->, ");
		let src  = words[0];
		let dsts = cat_strs(words[1:] + ",");
		max_outputs = max(max_outputs, i32(size(words)) - 1);
		if src[0] == "%"
		{
			types[id] = MODULE_FLIP;
			names[id] = src[1:];
		}
		else if src[0] == "&"
		{
			types[id] = MODULE_CONJ;
			names[id] = src[1:];
		}
		else
		{
			types[id] = MODULE_BRDC;
			names[id] = src;
		}

		if dsts == "rx,"
			rx_in = id;

		outputs_str.set(names[id], dsts);
		ids.set(names[id], i64(id));
		id += 1;

		str_ = readln(f);
	}
	close(f);

	// Convert graph from str dict to array
	let outputs  = [-1; max_outputs, n];
	let noutputs = [0; n];
	let ninputs  = [0; n];
	for i in [0: n]
	{
		let dsts = split_(outputs_str.get(names[i]), ",");
		noutputs[i] = size(dsts);
		for j in [0: noutputs[i]]
		{
			const id = ids.get(dsts[j]);
			if (id < 0) continue;
			outputs[j,i] = id;
			ninputs[id] += 1;
		}
	}
	const max_inputs = maxval(ninputs);
	let inputs = [-1; max_inputs, n];
	ninputs = 0;  // reset
	for i in [0: n]
	{
		for j in [0: noutputs[i]]
		{
			const out = outputs[j,i];
			if (out < 0) continue;
			inputs[ninputs[out], out] = i;
			ninputs[out] += 1;
		}
	}

	// In my input, module rx has one input -- module cn
	//
	// Module cn in turn has four inputs, all conjunctions:
	// - th
	// - sv
	// - gh
	// - ch
	//
	// Each of those four inputs (th, sv, gh, ch) is on an independent circuit
	// component with periodic behavior re button inputs
	//
	// So our answer is the LCM of those four periods

	const components = inputs[0: ninputs[rx_in], rx_in];
	//println("rx_in = ", rx_in, " (", names[rx_in], ")");
	//println("components = ", names[components]);

	let periods = [-1; n];
	let is_component = [false; n];
	is_component[components] = true;
	//println("is_component = ", is_component);
	//println("periods[components] = ", periods[components]);

	// Initialize state for flip-flops and conjunctions. Arrays are larger than
	// they need to be but nbd
	let fstate = [FLIP_OFF; n];
	let cstate = [PULSE_LO; max_inputs, n];
	let ibutton = 0;
	while true
	{
		ibutton += 1;

		// Queue of pulse type, destination module ID, and source ID
		let q = queue_vec_i32::new();

		// Pressing the button sends a low pulse to the broadcaster
		q.push([PULSE_LO, i32(ids.get("broadcaster")), -1]);
		while not q.is_empty()
		{
			const u = q.pop();
			const pulse  = u[0];
			const module = u[1];
			const src    = u[2];
			if (module < 0) continue;
			const type = types[module];

			if type == MODULE_BRDC
			{
				// The broadcaster sends the same pulse to all its destinations
				for dst in outputs[0: noutputs[module], module]
					q.push([pulse, dst, module]);
			}
			else if type == MODULE_FLIP
			{
				// Nothing happens for high pulse

				if pulse == PULSE_LO
				{
					// If it was off, it turns on and sends a high pulse. If it
					// was on, it turns off and sends a low pulse
					let pout = -1;
					if fstate[module] == FLIP_OFF
					{
						fstate[module] = FLIP_ON;
						pout = PULSE_HI;
					}
					else
					{
						fstate[module] = FLIP_OFF;
						pout = PULSE_LO;
					}
					for dst in outputs[0: noutputs[module], module]
						q.push([pout, dst, module]);
				}
			}
			else if type == MODULE_CONJ
			{
				// When a pulse is received, the conjunction module first
				// updates its memory for that input. Then, if it remembers high
				// pulses for all inputs, it sends a low pulse; otherwise, it
				// sends a high pulse.

				// Linear scan for index `j` of src in module's inputs
				let j = 0;
				while (inputs[j, module] != src) j += 1;

				// Update memory
				cstate[j, module] = pulse;

				// Track periods
				if is_component[module] and ibutton > 0
				{
					if periods[module] < 0
					{
						if all(cstate[0: ninputs[module], module] == PULSE_LO)
						{
							//println("period = ", ibutton);
							periods[module] = ibutton;
						}
					}
				}

				// Send pulse
				let pout = PULSE_HI;
				if all(cstate[0: ninputs[module], module] == PULSE_HI)
					pout = PULSE_LO;
				for dst in outputs[0: noutputs[module], module]
					q.push([pout, dst, module]);
			}
		}
		if all(periods[components] > 0)
			break;
	}
	println("periods[components] = ", periods[components]);
	sum_ = 1;
	for period in periods[components]
		sum_ = lcm64(sum_, i64(period));

	println("part 2 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2023/20" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "818723272";
	let expect2 = "243902373381257";
	let expect1_test = "32000000";
	let expect2_test = "";  // no part 2 test result today
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

