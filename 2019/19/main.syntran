
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;
use ../../queue_i64 as queue_i64;

use ../intcode;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const prog0 = read_i64_mat_delim(args.input_filename, ",")[:,0];
	//println("prog0 = ", prog0);

	let status = intcode::new_status();

	const nx = const ny = 50'i64;
	//const nx = const ny = 10'i64;
	let g = ["."; nx, ny];
	for y in [0: ny]
	for x in [0: nx]
	{
		let inputs = queue_i64::new();
		inputs.push(x);
		inputs.push(y);
		let prog = intcode::new_program(prog0);
		let outputs = prog.exec(&inputs, &status);
		//println("outputs = ", outputs.data);
		if outputs.pop() == 1
		//if outputs.pop() != 0
		{
			g[x,y] = "#";
			sum_ += 1;
		}
	}
	print_char_mat(&g);

	println("part 1 = ", sum_);
	return str(sum_);
}


//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2019/19" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	//if (args.do_p2) p2 = part2(&args);

	let expect1 = "181";
	let expect2 = "REPLACE_ME_P2";
	let expect1_test = "";
	let expect2_test = "";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

