fn test_square(yrow: i32, midslope: f64): bool
{
	// Test if we can fit a 100x100 square starting at row `yrow`

	// Get left/right edges at row yrow
	//
	// slope = y / x
	// x = y / slope
	const x1m = i32(yrow / midslope);
	const x1l = bisect_edge(0, x1m, yrow);  // TODO: unused
	const x1r = bisect_edge(x1m, 2*x1m, yrow);

	// Get left right edges 100 rows below
	const y2 = yrow + 100 - 1;
	const x2m = i32(y2 / midslope);
	const x2l = bisect_edge(0, x2m, y2);
	const x2r = bisect_edge(x2m, 2*x2m, y2);  // TODO: unused

	//const ans = x2l + 100 > x1r;
	const ans = x2l + 100 - 1 <= x1r;

	println();
	println("yrow = ", yrow);
	println("x1l, x1r = ", [x1l, x1r]);
	println("x2l, x2r = ", [x2l, x2r]);
	println("ans = ", ans);

	return ans;
}

//fn bisect_100(midslope: f64): [i32; :]
fn bisect_100(midslope: f64): i32
{
	// Use bisection and return the y value of the smallest row where we can fit
	// a 100x100 square
	let ylo = 50;
	let yhi = 100_000;  // could find this dynamically by doubling

	let olo = test_square(ylo, midslope);
	let ohi = test_square(yhi, midslope);
	if olo == ohi
	{
		println(ERROR_STR + "bad initial bisect_100 bound");
		exit(3);
	}
	while true
	{
		if ylo + 1 >= yhi
		{
			if (olo) return ylo;
			return yhi;
		}
		const ymd = (ylo + yhi) / 2;
		const omd = test_square(ymd, midslope);
		if olo == omd
		{
			ylo = ymd;
			olo = omd;
		}
		else
		{
			yhi = ymd;
			ohi = omd;
		}
	}
	return -1;
}

fn bisect_edge(xlo: i32, xhi: i32, y: i32): i32
{
	let olo = probe_point(xlo, y);
	let ohi = probe_point(xhi, y);
	if olo == ohi
	{
		println(ERROR_STR + "bad initial bisection bound");
		exit(1);
	}
	while true
	{
		if xlo + 1 >= xhi
		{
			if (olo == 1) return xlo;
			return xhi;
		}
		const xmd = (xlo + xhi) / 2;
		const omd = probe_point(xmd, y);
		if
			(olo == 1 and omd == 1 and ohi == 0) or
			(olo == 0 and omd == 0 and ohi == 1)
		{
			xlo = xmd;
			olo = omd;
		}
		else if
			(olo == 0 and omd == 1 and ohi == 1) or
			(olo == 1 and omd == 0 and ohi == 0)
		{
			xhi = xmd;
			ohi = omd;
		}
		else
		{
			println(ERROR_STR + "bad bisection");
			exit(2);
		}
	}
	return -1;
}

fn probe_point(x: i32, y: i32): i32
{
	let inputs = queue_i64::new();
	inputs.push(i64(x));
	inputs.push(i64(y));
	let prog = intcode::new_program(prog0_glbl);
	let status = intcode::new_status();
	let outputs = prog.exec(&inputs, &status);
	return(i32(outputs.pop()));
}

