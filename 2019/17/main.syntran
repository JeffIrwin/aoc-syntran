
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;
use ../../queue_i64 as queue_i64;
//use ../../queue_vec_i32 as queue_vec_i32;
use ../../stack_vec_i32 as stack_vec_i32;

use ../intcode;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const prog0 = read_i64_mat_delim(args.input_filename, ",")[:,0];
	//println("prog0 = ", prog0);

	let prog = intcode::new_program(prog0);
	let inputs = queue_i64::new();
	let status = intcode::new_status();

	let outputs = prog.exec(&inputs, &status);
	//println("outputs = ", outputs);

	let s = repeat(" ", outputs.len());
	let i = 0;
	while not outputs.is_empty()
	{
		s[i] = char(i32(outputs.pop()));
		i += 1;
	}
	//println("s = ");
	//println(s);

	const g0 = str_to_char_mat(&s, NEWLINE_);
	const nx0 = size(g0, 0);
	const ny0 = size(g0, 1);

	// Pad with a row/col of "." on every side to simplify the next steps
	const nx = nx0 + 2;
	const ny = ny0 + 2;
	let g = ["."; nx, ny];
	g[1: nx-1, 1: ny-1] = g0;

	//print_char_mat(&g);

	for y in [1: ny-1]
	for x in [1: nx-1]
	{
		// Current char and neighbors up, down, left, and right
		const c  = g[x,y];
		const cu = g[x,y-1];
		const cd = g[x,y+1];
		const cl = g[x-1,y];
		const cr = g[x+1,y];
		if all([c, cu, cd, cl, cr] == "#")
		{
			//println("x, y = ", [x, y]);
			sum_ += (x-1) * (y-1);  // minus 1 to account for padding
		}
	}

	println("part 1 = ", sum_);
	return str(sum_);
}

enum Heading
{
	up,
	down,
	left,
	right,
}
fn part2(args: &const Args): str
{
	let sum_ = 0'i64;

	const prog0 = read_i64_mat_delim(args.input_filename, ",")[:,0];
	//println("prog0 = ", prog0);

	let prog = intcode::new_program(prog0);
	let inputs = queue_i64::new();
	let status = intcode::new_status();

	let outputs = prog.exec(&inputs, &status);
	//println("outputs = ", outputs);

	let s = repeat(" ", outputs.len());
	let i = 0;
	while not outputs.is_empty()
	{
		s[i] = char(i32(outputs.pop()));
		i += 1;
	}
	//println("s = ");
	//println(s);

	const g0 = str_to_char_mat(&s, NEWLINE_);
	const nx0 = size(g0, 0);
	const ny0 = size(g0, 1);

	// Pad with a row/col of "." on every side to simplify the next steps
	const nx = nx0 + 2;
	const ny = ny0 + 2;
	let g = ["."; nx, ny];
	g[1: nx-1, 1: ny-1] = g0;

	print_char_mat(&g);

	//for y in [1: ny-1]
	//for x in [1: nx-1]
	//{
	//	// Current char and neighbors up, down, left, and right
	//	const c  = g[x,y];
	//	const cu = g[x,y-1];
	//	const cd = g[x,y+1];
	//	const cl = g[x-1,y];
	//	const cr = g[x+1,y];
	//	if all([c, cu, cd, cl, cr] == "#")
	//	{
	//		//println("x, y = ", [x, y]);
	//		sum_ += (x-1) * (y-1);  // minus 1 to account for padding
	//	}
	//}

	// Find initial robot position "^"
	//
	// No need to correct for padded coordinates here, only relative movement
	// commands matter, which are invariant to padding
	let rx = 0;
	let ry = 0;
	for y in [0: ny]
	for x in [0: nx]
		if g[x,y] == "^"
		{
			rx = x;
			ry = y;
		}
	println("rx, ry = ", [rx, ry]);
	let x = rx;
	let y = ry;

	// Find the path as a polyline. TODO: just push heading to polyline too?
	let pl = stack_vec_i32::new();
	pl.push([x, y]);
	let heading = Heading.up;
	if (g[x-1,y] == "#") heading = Heading.left;
	if (g[x+1,y] == "#") heading = Heading.right;
	if (g[x,y-1] == "#") heading = Heading.up;
	if (g[x,y+1] == "#") heading = Heading.down;

	println("heading = ", heading);

	while true
	{
		// Move along heading until we hit a corner
		//println("x, y = ", [x, y]);
		const x0 = x;
		const y0 = y;
		switch heading
		{
			case Heading.left
				x -= 1;
			case Heading.right
				x += 1;
			case Heading.up
				y -= 1;
			case Heading.down
				y += 1;
		}
		if (g[x,y] == "#") continue;

		// Corner. Backup and change heading
		x = x0;
		y = y0;
		pl.push([x, y]);
		const cu = g[x,y-1];
		const cd = g[x,y+1];
		const cl = g[x-1,y];
		const cr = g[x+1,y];
		switch heading
		{
			case Heading.left, Heading.right
			{
				heading = Heading.up;
				if cd == "#"
					heading = Heading.down;
				else if cu != "#"
					break;  // terminus
			}
			case Heading.up, Heading.down
			{
				heading = Heading.right;
				if cl == "#"
					heading = Heading.left;
				else if cr != "#"
					break;  // terminus
			}
		}
		println("heading = ", heading);
		//break;
	}

	println("pl = ", pl.vals[:, :pl.len]);

	// TODO: re-draw grid from polyline alone. Verify that it matches the
	// original grid, otherwise we have failed to visit every scaffold point
	let g2 = ["."; nx, ny];
	for ip in [0: pl.len-1]
	{
		let x0 = pl.vals[0, ip];
		let y0 = pl.vals[1, ip];
		let x1 = pl.vals[0, ip+1];
		let y1 = pl.vals[1, ip+1];
		if x0 == x1
		{
			if y0 > y1
			{
				let tmp = y0;
				y0 = y1;
				y1 = tmp;
			}
			g2[x0, y0:y1+1] = "#";
		}
		else if y0 == y1
		{
			if x0 > x1
			{
				let tmp = x0;
				x0 = x1;
				x1 = tmp;
			}
			g2[x0:x1+1, y0] = "#";
		}
		else
		{
			println(ERROR_STR + "bad polyline");
			exit(1);
		}
	}
	// Draw initial position
	g2[rx, ry] = "^";
	print_char_mat(&g2);
	println("g == g2 = ", all(g == g2));
	if not all(g == g2)
	{
		println(ERROR_STR + "naive walk failed to visit all points");
		exit(2);
	}

	// TODO: edit code above to save headings. Then build instruction str from
	// polyline (with headings) as move+walk instructions
	//
	// Finally, compress the instruction str as 3 functions (may be able to do
	// this part manually more easily first than programmatically)

	println("part 2 = ", sum_);
	return str(sum_);
}


//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2019/17" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "REPLACE_ME_P1";
	let expect2 = "REPLACE_ME_P2";
	let expect1_test = "REPLACE_ME_P1_TEST";
	let expect2_test = "REPLACE_ME_P2_TEST";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

