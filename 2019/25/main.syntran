
use ../../utils::*;
use ../../dict_i64_2026 as dict_i64;
use ../../dict_str_2026 as dict_str;
use ../../queue_i64 as queue_i64;
use ../../queue_str as queue_str;

use ../intcode;

//==============================================================================

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const prog0 = read_i64_mat_delim(args.input_filename, ",")[:,0];
	let prog = intcode::new_program(prog0);

	// Out-args for output string parsing
	let name  = "";
	let doors = [""; 0];
	let citems = [""; 0];

	let out = run_command(&prog, "");
	parse_output(out, &name, &doors, &citems);

	//println("name = '", name, "'");
	//println("doors = ", doors);

	// Build map of where each room is relative to its neighbors

	// Graph of rooms for which all neighbors are known
	let map  = dict_str::new();

	// Set of all rooms
	let seen = dict_i64::new();

	// Queue of rooms which we have seen but not yet mapped neighbors
	let unmapped = queue_str::new();

	unmapped.push(name);
	//println("unmapped = ", unmapped.get_vals());

	let opp_dir = dict_str::new();
	opp_dir.set("north", "south");
	opp_dir.set("south", "north");
	opp_dir.set("east" , "west" );
	opp_dir.set("west" , "east" );

	const pressure_name = " Pressure-Sensitive Floor ";

	println("Searching rooms and taking items ...");
	let items = [""; 0];
	let curr = name;
	while true
	{
		// This alrogithm is probably not optimal. Instead of popping the first
		// unmapped room, we could do one BFS to *all* unmapped rooms and pick
		// whichever is closest for better performance
		//
		// The weight brute-forcing stage is slower anyway
		if unmapped.is_empty() break;
		const next = unmapped.pop();
		if (next == pressure_name) continue;

		const path = bfs(&map, curr, next);
		//println("path = ", path);

		// Traverse the path
		for p in path
			out = run_command(&prog, p + NEWLINE_);

		parse_output(out, &name, &doors, &citems);
		//println("new doors = ", doors);
		curr = next;

		for door in doors
		{
			// Go through the door
			let out = run_command(&prog, door + NEWLINE_);

			let nbr = "";
			let ndoors = [""; 0];
			let nitems = [""; 0];
			parse_output(out, &nbr, &ndoors, &nitems);
			for item in nitems
			{
				//println("item = ", item);

				// Actually an infinite loop. No status return
				if (item == "infinite loop") continue;

				// Stuck. Subsequent movement commands do nothing
				if (item == "giant electromagnet") continue;

				let status = intcode::new_status();
				const p0 = prog;  // save state
				out = run_command_stat(&prog, "take " + item + NEWLINE_, &status);
				//println(out);
				//println("status = ", status);
				if status == intcode::Status.halt
				{
					// Reset program state after game-ending items
					prog = p0;
				}
				else
					items = [items, [item]];
			}

			let curr_map = map.get(curr);
			map.set(curr, curr_map + door + ":" + nbr + ",");

			if not seen.contains(nbr)
				unmapped.push(nbr);

			// Pressure floor automatically kicks us out
			if nbr == pressure_name
				continue;

			// Go back to curr for the next iteration
			const opp = opp_dir.get(door);
			out = run_command(&prog, opp + NEWLINE_);
		}
		//println("curr_map = ", map.get(curr));

		seen.set(curr, 1'i64);
	}
	//println("seen = ", sort_inplace_str(seen.get_keys()));

	// Travel from wherever we ended up to the security checkpoint
	for p in bfs(&map, curr, " Security Checkpoint ")
		out = run_command(&prog, p + NEWLINE_);
	const path = bfs(&map, curr, pressure_name);

	//println("items = ", items);

	const ni = i32(size(items));
	const too_heavy = "Droids on this ship are lighter than the detected";
	const too_light = "Droids on this ship are heavier than the detected";
	const success_msg = "should be able to get in";

	println("Brute-forcing key weight ...");
	for mask in [0: 2 ** ni]
	{
		let drop = "";
		for i in [0: ni]
			if (1 << i) & mask != 0
				drop += "drop " + items[i] + NEWLINE_;
		let out = run_command(&prog, drop);
		out = run_command(&prog, path[0] + NEWLINE_);

		if index_(out, too_heavy) < 0 and index_(out, too_light) < 0
		{
			const lines = split_(out, NEWLINE_);
			for line in lines
				if index_(line, success_msg) >= 0
					sum_ = parse_i64(split_(line, " ")[11]);
			break;
		}

		// Pick back up what we just dropped
		let take = "";
		for i in [0: ni]
			if (1 << i) & mask != 0
				take += "take " + items[i] + NEWLINE_;
		out = run_command(&prog, take);
	}

	println("part 1 = ", sum_);
	return str(sum_);
}

fn bfs(map: &const dict_str::dict_str, curr: str, next: str): [str; :]
{
	// BFS in-memory (without executing intcode) to get the path of movement
	// commands from curr to next
	if curr == next
		return [""; 0];
	let q = queue_str::new();
	q.push(curr);

	let prev = dict_str::new();
	let move = dict_str::new();
	let seen = dict_i64::new();
	while true
	{
		if (q.is_empty()) break;
		const u = q.pop();
		if (u == next) break;
		seen.set(u, 1'i64);

		const dir_nbrs = map.get(u);
		for dir_nbr in split_(dir_nbrs, ",")
		{
			const words = split_(dir_nbr, ":");
			const dir = words[0];
			const nbr = words[1];
			if seen.contains(nbr) continue;
			q.push(nbr);
			prev.set(nbr, u);
			move.set(nbr, dir);
		}
	}

	// Backtrack to set (reversed) path
	let path = [""; 0];
	let u = next;
	while true
	{
		const p = prev.get(u);
		path = [path, [move.get(u)]];  // non-optimal array growth
		if (p == curr) break;
		u = p;
	}
	return path[:-1:];
}

fn parse_output
(
	output: &const str,  // input to this fn
	name: &str,          // output: name of room we're in
	doors: &[str; :],    // output: doors here lead
	items: &[str; :],    // output: items here
)
{
	name  = "";  // reset
	doors = [""; 0];
	items = [""; 0];

	const lines = split_(output, NEWLINE_);
	//println("lines = ", lines);
	let i = 0;
	while i < size(lines)
	{
		let line = lines[i];
		//println("line = '", line, "'");
		if starts_with_(line, "==") and name == ""
			name = split_(line, "=")[0];
		else if starts_with_(line, "Doors here lead:")
		{
			while true
			{
				// Beware split_() by NEWLINE_ combines consecutive NEWLINE_
				// delimiters, so it ignores blank lines
				i += 1;
				line = lines[i];
				//println("    line = '", line, "'");
				if not starts_with_(line, "- ") break;
				doors = [doors, [split_(line, "- ")]];
			}
			i -= 1;
		}
		else if starts_with_(line, "Items here:")
		{
			while true
			{
				i += 1;
				line = lines[i];
				if not starts_with_(line, "- ") break;
				items = [items, [line[2:]]];
			}
			i -= 1;
		}
		i += 1;
	}
	//println("items = ", items);
}

fn run_command(prog: &intcode::Program, input: str): str
{
	// Simple wrapper with no status arg exposed
	let status = intcode::new_status();
	return run_command_stat(&prog, input, &status);
}

fn run_command_stat(prog: &intcode::Program, input: str,
	status: &intcode::Status): str
{
	// Return status out-arg
	let inputs = queue_i64::new();
	for c in input
		inputs.push(i64(i32(c)));
	//println(">>> " + input);
	let outputs = prog.exec(&inputs, &status);
	let output = repeat(" ", outputs.len());
	for i in [0: outputs.len()]
		output[i] = char(i32(outputs.pop()));
	//println(output);
	return output;
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2019/25" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	// no part 2 today

	let expect1 = "352325632";
	let expect2 = "";
	let expect1_test = "";
	let expect2_test = "";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

