
use ../../utils::*;
use ../../dict_i64_2026 as dict_i64;

//==============================================================================

use ../../queue_i64 as queue_i64;
enum Opcode
{
	add        =  1,
	mul        =  2,
	input      =  3,
	output     =  4,
	jump_true  =  5,
	jump_false =  6,
	less_than  =  7,
	equals     =  8,
	inc_rb     =  9,
	halt       = 99,
}
enum Status
{
	wait_input,
	halt,
	abnormal,  // should be unreachable for behaved programs if i don't have bugs
}
fn new_status(): Status
{
	return Status.abnormal;  // abnormal essentially means uninitialized
}

struct Program
{
	prog: [i64; :],  // the actual intcode program int array
	ip  : i32,       // instruction pointer
	rb  : i32,       // relative base

	fn set_param(modes: &const [i32; :], iparam: i32, val: i64)
	{
		let index = -1;
		switch modes[iparam-1]
		{
			case 0
				index = prog[ip + iparam];
			case 2
				index = rb + prog[ip + iparam];
			default
			{
				println(ERROR_STR + "bad write mode");
				exit(3);
			}
		}
		const sz = size(prog);
		if index >= sz
		{
			// Grow by doubling
			const new_sz = 2'i64 * max(index, 1);
			let new_prog = [0'i64; new_sz];
			new_prog[0: sz] = prog;
			prog = new_prog;
		}
		prog[index] = val;
	}

	fn get_param(modes: &const [i32; :], iparam: i32): i64
	{
		let param = prog[ip + iparam];
		switch modes[iparam-1]
		{
			case 0
			{
				if param < size(prog)
					param = prog[param];
				else
					param = 0;
			}
			case 1
			{
				// no-op. immediate mode already initialized above
			}
			case 2
			{
				if rb + param < size(prog)
					param = prog[rb + param];
				else
					param = 0;
			}
			default
			{
				println(ERROR_STR + "bad intcode parameter mode: ",
					modes[iparam-1]);
				exit(2);
			}
		}
		return param;
	}

	fn exec(inputs : &queue_i64::Queue_i64, stat: &Status): queue_i64::Queue_i64
	{
		// exec() returns a status out-arg to say whether we are waiting for
		// more input or if we have halted
		//
		// The input queue is never padded
		stat = Status.abnormal;
		let outputs = queue_i64::new();
		while true
		{
			const instr = prog[ip];
			const op = instr % 100;

			const modes = i32([
				(instr /   100) % 10, // hundreds digit
				(instr /  1000) % 10, // thousands digit
				(instr / 10000) % 10, // ten-thousands
			]);
			//println();
			//println("instr = ", instr);
			//println("modes = ", modes);

			switch Opcode(op)
			{
				case Opcode.add
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					const res = param1 + param2;
					//println("add ", [param1, param2], " = ", res);
					set_param(modes, 3, res);
					ip += 4;
				}
				case Opcode.mul
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					const res = param1 * param2;
					//println("mul ", [param1, param2], " = ", res);
					set_param(modes, 3, res);
					ip += 4;
				}
				case Opcode.input
				{
					if inputs.is_empty()
					{
						stat = Status.wait_input;
						return outputs;
					}
					const res = inputs.pop();
					set_param(modes, 1, res);
					ip += 2;
				}
				case Opcode.output
				{
					const param1 = get_param(modes, 1);
					//println("output: ", param1);
					outputs.push(param1);
					ip += 2;
				}
				case Opcode.jump_true
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					//println("jump_true ", [param1, param2]);
					if param1 != 0
						ip = param2;
					else
						ip += 3;
				}
				case Opcode.jump_false
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					//println("jump_false ", [param1, param2]);
					if param1 == 0
						ip = param2;
					else
						ip += 3;
				}
				case Opcode.less_than
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					let res = 0'i64;
					if param1 < param2
						res = 1;
					//println("less_than ", [param1, param2], " = ", res);
					set_param(modes, 3, res);
					ip += 4;
				}
				case Opcode.equals
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					let res = 0'i64;
					if param1 == param2
						res = 1;
					//println("equals ", [param1, param2], " = ", res);
					set_param(modes, 3, res);
					ip += 4;
				}
				case Opcode.inc_rb
				{
					const param1 = get_param(modes, 1);
					rb += param1;
					ip += 2;
				}
				case Opcode.halt
				{
					ip += 1;
					stat = Status.halt;
					return outputs;
				}
				default
				{
					println(ERROR_STR, "bad opcode: ", op);
					exit(1);
				}
			}
		}
		return outputs;  // abnormal
	}
}
fn new_program(prog: &const [i64; :]): Program
{
	return Program
	{
		prog = prog,
		ip   = 0,
		rb   = 0,
	};
}

enum Heading
{
	up,  // ordered clockwise
	right,
	down,
	left,
}
fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const prog0 = read_i64_mat_delim(args.input_filename, ",")[:,0];
	//println("prog0 = ", prog0);

	let prog = new_program(prog0);
	let stat = new_status();
	let inputs  = queue_i64::new();
	let x = let y = 0;
	let colors = dict_i64::new();
	let heading = Heading.up;
	while true
	{
		const key = str(x, ",", y);
		let color = 0'i64;
		if colors.contains(key)
			color = colors.get(key);

		inputs.push(color);
		let outputs = prog.exec(&inputs, &stat);
		if stat == Status.halt
			break;
		//println("x, y, color, outputs = ", x, ", ", y, ", ", color, outputs.data);

		const paint = outputs.pop();
		const turn  = outputs.pop();
		colors.set(key, paint);

		if turn == 1
			heading = Heading((i32(heading) + 1) % size(Heading));
		else
			heading = Heading(pmod(i32(heading) - 1, i32(size(Heading))));

		switch heading
		{
			case Heading.up
				y += 1;
			case Heading.right
				x += 1;
			case Heading.down
				y -= 1;
			case Heading.left
				x -= 1;
		}
	}
	sum_ = colors.len();

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	const prog0 = read_i64_mat_delim(args.input_filename, ",")[:,0];
	//println("prog0 = ", prog0);

	let prog = new_program(prog0);
	let stat = new_status();
	let inputs  = queue_i64::new();
	let x = let y = 0;
	let colors = dict_i64::new();
	colors.set("0,0", 1'i64);  // different starting color for part 2
	let heading = Heading.up;
	while true
	{
		const key = str(x, ",", y);
		let color = 0'i64;
		if colors.contains(key)
			color = colors.get(key);

		inputs.push(color);
		let outputs = prog.exec(&inputs, &stat);
		if stat == Status.halt
			break;
		//println("x, y, color, outputs = ", x, ", ", y, ", ", color, outputs.data);

		const paint = outputs.pop();
		const turn  = outputs.pop();
		colors.set(key, paint);

		if turn == 1
			heading = Heading((i32(heading) + 1) % size(Heading));
		else
			heading = Heading(pmod(i32(heading) - 1, i32(size(Heading))));

		switch heading
		{
			case Heading.up
				y += 1;
			case Heading.right
				x += 1;
			case Heading.down
				y -= 1;
			case Heading.left
				x -= 1;
		}
	}

	let xmin = let xmax = let ymin = let ymax = 0;
	for key in colors.get_keys()
	{
		const xy = parse_i32_delim(key, ",");
		xmin = min(xmin, xy[0]);
		ymin = min(ymin, xy[1]);
		xmax = max(xmax, xy[0]);
		ymax = max(ymax, xy[1]);
	}
	println("xy min/max = ", [xmin, xmax, ymin, ymax]);
	const nx = xmax - xmin + 1;
	const ny = ymax - ymin + 1;
	let g = [" "; nx, ny];
	for key in colors.get_keys()
	{
		const val = colors.get(key);
		if val == 0
			continue;
		const xy = parse_i32_delim(key, ",");
		g[xy[0] - xmin, ymax - xy[1]] = "#";
	}

	let ans = NEWLINE_ + char_mat_to_str(&g);
	println("part 2 = ", ans);
	return ans;
}

