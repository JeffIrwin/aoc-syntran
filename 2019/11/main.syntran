
use ../../utils::*;
use ../../dict_i64_2026 as dict_i64;
use ../../queue_i64 as queue_i64;

use ../intcode;

//==============================================================================

enum Heading
{
	up,  // ordered clockwise
	right,
	down,
	left,
}
fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const prog0 = read_i64_mat_delim(args.input_filename, ",")[:,0];
	//println("prog0 = ", prog0);

	let prog = intcode::new_program(prog0);
	let stat = intcode::new_status();
	let inputs  = queue_i64::new();
	let x = let y = 0;
	let colors = dict_i64::new();
	let heading = Heading.up;
	while true
	{
		const key = str(x, ",", y);
		let color = 0'i64;
		if colors.contains(key)
			color = colors.get(key);

		inputs.push(color);
		let outputs = prog.exec(&inputs, &stat);
		if stat == intcode::Status.halt
			break;
		//println("x, y, color, outputs = ", x, ", ", y, ", ", color, outputs.data);

		const paint = outputs.pop();
		const turn  = outputs.pop();
		colors.set(key, paint);

		if turn == 1
			heading = Heading((i32(heading) + 1) % size(Heading));
		else
			heading = Heading(pmod(i32(heading) - 1, i32(size(Heading))));

		switch heading
		{
			case Heading.up
				y += 1;
			case Heading.right
				x += 1;
			case Heading.down
				y -= 1;
			case Heading.left
				x -= 1;
		}
	}
	sum_ = colors.len();

	println("part 1 = ", sum_);
	return str(sum_);
}

fn part2(args: &const Args): str
{
	const prog0 = read_i64_mat_delim(args.input_filename, ",")[:,0];
	//println("prog0 = ", prog0);

	let prog = intcode::new_program(prog0);
	let stat = intcode::new_status();
	let inputs  = queue_i64::new();
	let x = let y = 0;
	let colors = dict_i64::new();
	colors.set("0,0", 1'i64);  // different starting color for part 2
	let heading = Heading.up;
	while true
	{
		const key = str(x, ",", y);
		let color = 0'i64;
		if colors.contains(key)
			color = colors.get(key);

		inputs.push(color);
		let outputs = prog.exec(&inputs, &stat);
		if stat == intcode::Status.halt
			break;
		//println("x, y, color, outputs = ", x, ", ", y, ", ", color, outputs.data);

		const paint = outputs.pop();
		const turn  = outputs.pop();
		colors.set(key, paint);

		if turn == 1
			heading = Heading((i32(heading) + 1) % size(Heading));
		else
			heading = Heading(pmod(i32(heading) - 1, i32(size(Heading))));

		switch heading
		{
			case Heading.up
				y += 1;
			case Heading.right
				x += 1;
			case Heading.down
				y -= 1;
			case Heading.left
				x -= 1;
		}
	}

	let xmin = let xmax = let ymin = let ymax = 0;
	for key in colors.get_keys()
	{
		const xy = parse_i32_delim(key, ",");
		xmin = min(xmin, xy[0]);
		ymin = min(ymin, xy[1]);
		xmax = max(xmax, xy[0]);
		ymax = max(ymax, xy[1]);
	}
	println("xy min/max = ", [xmin, xmax, ymin, ymax]);
	const nx = xmax - xmin + 1;
	const ny = ymax - ymin + 1;
	let g = [" "; nx, ny];
	for key in colors.get_keys()
	{
		const val = colors.get(key);
		if val == 0
			continue;
		const xy = parse_i32_delim(key, ",");
		g[xy[0] - xmin, ymax - xy[1]] = "#";
	}

	let ans = NEWLINE_ + char_mat_to_str(&g);
	println("part 2 = ", ans);
	return ans;
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2019/11" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	if (args.do_p2) p2 = part2(&args);

	let expect1 = "2339";
	let expect2 = "
 ###   ##  #  # #### ###  #    ###  ###    
 #  # #  # #  # #    #  # #    #  # #  #   
 #  # #    #  # ###  #  # #    #  # #  #   
 ###  # ## #  # #    ###  #    ###  ###    
 #    #  # #  # #    #    #    #    # #    
 #     ###  ##  #### #    #### #    #  #   
";

	let expect1_test = "";
	let expect2_test = "REPLACE_ME_P2_TEST";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

