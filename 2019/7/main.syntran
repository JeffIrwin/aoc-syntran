
use ../../utils::*;
//use ../../dict_i64_2026 as dict_i64;
use ../../queue_i32 as queue_i32;

//==============================================================================

enum opcode
{
	add        =  1,
	mul        =  2,
	input      =  3,
	output     =  4,
	jump_true  =  5,
	jump_false =  6,
	less_than  =  7,
	equals     =  8,
	halt       = 99,
}

struct Program
{
	prog: [i32; :],  // the actual intcode program int array
	ip  : i32,       // instruction pointer

	fn get_param(modes: &const [i32; :], iparam: i32): i32
	{
		// Might also want a 'state' struct with prog and ip
		let param = prog[ip + iparam];
		if modes[iparam-1] == 0
			param = prog[param];
		return param;
	}

	fn exec1(inputs : &queue_i32::Queue_i32): queue_i32::Queue_i32
	{
		let outputs = queue_i32::new();
		while true
		{
			const instr = prog[ip];
			const op = instr % 100;
	
			const modes = [
				(instr /   100) % 10, // hundreds digit
				(instr /  1000) % 10, // thousands digit
				(instr / 10000) % 10, // ten-thousands
			];
			//println();
			//println("instr = ", instr);
			//println("modes = ", modes);
	
			switch opcode(op)
			{
				case opcode.add
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					const res = param1 + param2;
					//println("add ", [param1, param2], " = ", res);
					prog[prog[ip+3]] = res;
					ip += 4;
				}
				case opcode.mul
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					const res = param1 * param2;
					//println("mul ", [param1, param2], " = ", res);
					prog[prog[ip+3]] = res;
					ip += 4;
				}
				case opcode.input
				{
					//const res = inputs.pop();
					let res = 0;
					if not inputs.is_empty()
						res = inputs.pop();
	
					//println("input = ", res);
					prog[prog[ip+1]] = res;
					ip += 2;
				}
				case opcode.output
				{
					const param1 = get_param(modes, 1);
					//println("output: ", param1);
					outputs.push(param1);
					ip += 2;
				}
				case opcode.jump_true
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					//println("jump_true ", [param1, param2]);
					if param1 != 0
						ip = param2;
					else
						ip += 3;
				}
				case opcode.jump_false
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					//println("jump_false ", [param1, param2]);
					if param1 == 0
						ip = param2;
					else
						ip += 3;
				}
				case opcode.less_than
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					let res = 0;
					if param1 < param2
						res = 1;
					//println("less_than ", [param1, param2], " = ", res);
					prog[prog[ip+3]] = res;
					ip += 4;
				}
				case opcode.equals
				{
					const param1 = get_param(modes, 1);
					const param2 = get_param(modes, 2);
					let res = 0;
					if param1 == param2
						res = 1;
					//println("equals ", [param1, param2], " = ", res);
					prog[prog[ip+3]] = res;
					ip += 4;
				}
				case opcode.halt
				{
					ip += 1;
					break;
				}
				default
				{
					println(ERROR_STR, "bad opcode: ", op);
					exit(1);
				}
			}
		}
		return outputs;
	}
}
fn new_program(prog: &const [i32; :]): Program
{
	return Program
	{
		prog = prog,
		ip   = 0,
	};
}

fn part1(args: &const Args): str
{
	let sum_ = 0'i64;

	const prog0 = read_i32_mat_delim(args.input_filename, ",")[:,0];
	//println("prog0 = ", prog0);

	// Try every combination -- only 5**5 == 3125
	for i0 in [0: 5]
	for i1 in [0: 5]
	for i2 in [0: 5]
	for i3 in [0: 5]
	for i4 in [0: 5]
	{
		if (i0 == i1) continue;  // :(
		if (i0 == i2) continue;
		if (i1 == i2) continue;
		if (i0 == i3) continue;
		if (i1 == i3) continue;
		if (i2 == i3) continue;
		if (i0 == i4) continue;
		if (i1 == i4) continue;
		if (i2 == i4) continue;
		if (i3 == i4) continue;

		const phases = [i0, i1, i2, i3, i4];
		//println("phases = ", phases);

		const namp = size(phases);
		let inputs  = queue_i32::new();
		let outputs = queue_i32::new();
		inputs.push(phases[0]);
		for iamp in [0: namp]
		{
			//println("inputs = ", inputs.data);
			let prog = new_program(prog0);
			outputs = prog.exec1(&inputs);
			//println("outputs = ", outputs.data);
			if iamp >= namp-1
				continue;

			inputs = queue_i32::new();
			inputs.push(phases[iamp+1]);
			while not outputs.is_empty()
				inputs.push( outputs.pop() );
		}
		sum_ = max(sum_, i64(outputs.pop()));
	}

	println("part 1 = ", sum_);
	return str(sum_);
}

//==============================================================================

fn main(): str
{
	// For unit-testing (within the syntran repo), this main fn returns a value
	// to be compared with expected results
	println();
	println(MAGENTA + "Starting AOC syntran main 2019/7" + RESET);
	let args = parse_args();

	let p1 = ""; let p2 = "";

	if (args.do_p1) p1 = part1(&args);
	//if (args.do_p2) p2 = part2(&args);

	let expect1 = "45730";
	let expect2 = "REPLACE_ME_P2";
	let expect1_test = "43210";
	let expect2_test = "REPLACE_ME_P2_TEST";
	check_aoc_results(args, p1, p2, expect1, expect2, expect1_test, expect2_test);

	println(GREEN + "Ending AOC syntran main" + RESET);
	println();
	return p1 + ":" + p2;
}

//==============================================================================

return main();

